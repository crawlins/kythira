# Sample EnvironmentFile for a kythira node driving an OCI Instance Pool
# (`.kiro/specs/oci-cloud-provider/`, Requirement 15.1). Copy to
# /etc/default/oci_quorum_manager (mode 0600 — it holds a private key) and
# fill in the OCIDs for your own tenancy.
#
# Every variable below maps to exactly one field of
# `kythira::oci_client_config` (include/raft/oci_client_config.hpp) or
# `kythira::oci_instance_pool_quorum_manager_config`
# (include/raft/oci_instance_pool_quorum_manager.hpp), named in the comment
# above it. Nothing here is read by the library itself — the library takes a
# populated struct — so this file is the documented contract between your
# deployment's config loader and those two structs, and the field names are
# spelled out so a rename shows up as a diff in both places.
#
# ── ONE INSTANCE POOL PER AVAILABILITY DOMAIN ────────────────────────────────
#
# This is the load-bearing operational constraint, not a preference.
# `UpdateInstancePool` takes one pool-wide `size`; OCI's own placement
# algorithm decides which of the pool's placement configurations absorbs the
# new capacity, and no OCI API accepts a per-AD count. A manager pointed at a
# multi-AD pool therefore cannot honour `provision_node(target_group)` — it
# could only grow the pool and hope the instance landed where it was asked
# for. So a three-AD cluster is THREE Instance Pools, each with a single
# placement configuration, and THREE `oci_instance_pool_quorum_manager`
# instances, each with this file filled in for its own AD:
#
#   pool ocid1.instancepool…phx1  →  placement AD kIdk:PHX-AD-1  →  manager 1
#   pool ocid1.instancepool…phx2  →  placement AD kIdk:PHX-AD-2  →  manager 2
#   pool ocid1.instancepool…phx3  →  placement AD kIdk:PHX-AD-3  →  manager 3
#
# The manager enforces its half of this: `provision_node` rejects a
# `target_group` the configured pool has no placement configuration for,
# rather than provisioning into the wrong failure domain. It cannot enforce
# the other half — that you gave each pool exactly one AD.
#
# See ./README.md for how to create the prerequisite resources.

# ── oci_client_config ────────────────────────────────────────────────────────

# oci_client_config::region — OCI region identifier. Used to derive the
# per-service hosts. The domain differs BY SERVICE and no single template is
# correct: Core Services is iaas.{region}.oraclecloud.com (the `oci` form 404s
# GetVnic), while the certificate services only exist as
# certificatesmanagement/certificates.{region}.oci.oraclecloud.com. See
# spike-notes.md Finding 10.
OCI_REGION=us-phoenix-1

# oci_client_config::tenancy_id — tenancy (root compartment) OCID.
# Required unless OCI_USE_INSTANCE_PRINCIPAL=true.
OCI_TENANCY_ID=ocid1.tenancy.oc1..aaaaaaaareplace

# oci_client_config::user_id — OCID of the IAM user whose API key signs
# requests. Required unless OCI_USE_INSTANCE_PRINCIPAL=true.
OCI_USER_ID=ocid1.user.oc1..aaaaaaaareplace

# oci_client_config::fingerprint — the API key's fingerprint exactly as the
# OCI console shows it (colon-separated hex).
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99

# oci_client_config::private_key_pem — the PEM-encoded RSA private key
# ITSELF, not a path to it. The library does no filesystem access, which is
# what lets a deployment source the key from a secret store instead of a
# file. If you do keep it in a file, load it in your config loader:
#
#   OCI_PRIVATE_KEY_PEM="$(cat /etc/oci/api_key.pem)"
#
# Whatever holds this value is a secret at rest — mode 0600 at minimum.
OCI_PRIVATE_KEY_PEM=

# oci_client_config::private_key_passphrase — leave empty for an
# unencrypted key.
OCI_PRIVATE_KEY_PASSPHRASE=

# oci_client_config::use_instance_principal — authenticate as the instance
# itself via the local metadata service instead of the API-key fields above.
#
# **NOT YET IMPLEMENTED.** Setting this true makes every signing attempt
# throw a named error rather than silently falling back to the API key —
# falling back would authenticate as the wrong principal, which is worse
# than failing. See `.kiro/specs/oci-cloud-provider/spike-notes.md`, Task
# 0(b), for what is still missing (the metadata-service endpoint set and
# refresh cadence).
OCI_USE_INSTANCE_PRINCIPAL=false

# oci_client_config::endpoint_override — replaces the derived host for
# EVERY service, not per service. Empty in production; the tests use it to
# point at `tests/oci_mock_server.hpp`.
OCI_ENDPOINT_OVERRIDE=

# oci_client_config::api_timeout — seconds. Bounds both the connect and the
# read phase of a single OCI call, and also bounds
# `oci_certificates_provider::sign_csr`'s wait for a certificate to become
# ACTIVE.
OCI_API_TIMEOUT_SECONDS=30

# ── oci_instance_pool_quorum_manager_config ──────────────────────────────────

# oci_instance_pool_quorum_manager_config::compartment_id — scopes every
# lookup. Required.
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaareplace

# oci_instance_pool_quorum_manager_config::cluster_name — written to the
# `kythira-cluster` freeform tag on every managed instance. Required.
OCI_CLUSTER_NAME=kythira-prod

# oci_instance_pool_quorum_manager_config::instance_pool_id — OCID of a
# PRE-EXISTING, single-AD Instance Pool. The manager never creates a pool or
# an Instance Configuration; both are operator-provisioned (README.md §2).
# Required, and read once at construction to confirm it exists and to learn
# its Availability Domain.
OCI_INSTANCE_POOL_ID=ocid1.instancepool.oc1.phx.aaaaaaaareplace

# oci_instance_pool_quorum_manager_config::node_port — the port the kythira
# process listens on; appended to the discovered private IP to form the
# address `provision_node` returns.
OCI_NODE_PORT=7000

# oci_instance_pool_quorum_manager_config::heartbeat_timeout — seconds. How
# fresh the `kythira-last-heartbeat` tag must be for a RUNNING instance to
# count as live. Set to 0 to disable the heartbeat rule entirely and fall
# back to `lifecycleState` alone — which will report a node whose kythira
# process has wedged as perfectly healthy.
OCI_HEARTBEAT_TIMEOUT_SECONDS=30

# oci_instance_pool_quorum_manager_config::heartbeat_grace_period — seconds.
# How long after `timeCreated` an instance with no heartbeat tag yet still
# counts as live. Must comfortably exceed your boot-to-first-heartbeat time,
# or every freshly launched node is classified unreachable and immediately
# replaced — a provisioning loop that looks like a capacity problem.
OCI_HEARTBEAT_GRACE_PERIOD_SECONDS=120

# oci_instance_pool_quorum_manager_config::topology — target voting-node
# count for THIS manager's Availability Domain. One entry, because one
# manager owns one single-AD pool (see the header). Spell the AD exactly as
# OCI reports it, tenancy prefix included.
OCI_TOPOLOGY_AVAILABILITY_DOMAIN=kIdk:PHX-AD-1
OCI_TOPOLOGY_TARGET_COUNT=1

# oci_instance_pool_quorum_manager_config::provision_timeout — seconds to
# wait for a newly launched instance to appear in the pool. On expiry the
# manager rolls the pool size back to what it was and rejects the call.
# 300s allows for an "Out of host capacity" retry inside OCI itself.
OCI_PROVISION_TIMEOUT_SECONDS=300

# oci_instance_pool_quorum_manager_config::poll_interval — milliseconds
# between `ListInstancePoolInstances` polls while provisioning.
OCI_POLL_INTERVAL_MS=5000

# oci_instance_pool_quorum_manager_config::extra_tags — additional freeform
# tags merged onto every managed instance, as comma-separated key=value
# pairs for your config loader to split. These CANNOT override
# `kythira-cluster`, `kythira-node-id`, `kythira-group` or
# `kythira-managed-by`; the manager assigns those last.
#
# Note the hyphens. OCI freeform tag KEYS do not accept the colon the AWS
# and Azure tags use, so this project's OCI tags are `kythira-cluster`, not
# `kythira:cluster`.
OCI_EXTRA_TAGS=owner=platform-team,environment=prod

# ── oci_certificates_provider_config (optional, second component) ────────────

# oci_certificates_provider_config::compartment_id — usually the same
# compartment as above; separate so the CA can live elsewhere.
OCI_CERTIFICATES_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaareplace

# oci_certificates_provider_config::certificate_authority_id — OCID of a
# PRE-EXISTING OCI Certificate Authority. The provider never creates or
# deletes one; a CA is a billed, ongoing resource (README.md §5).
OCI_CERTIFICATE_AUTHORITY_ID=ocid1.certificateauthority.oc1.phx.aaaaaaaareplace

# oci_certificates_provider_config::validity — seconds. The default validity
# for issued leaf certificates, used when the per-call
# `csr_signing_options::validity` is left at zero. 2592000 = 30 days.
OCI_CERTIFICATE_VALIDITY_SECONDS=2592000

# oci_certificates_provider_config::poll_interval — milliseconds between
# `GetCertificate` polls while issuance completes.
OCI_CERTIFICATE_POLL_INTERVAL_MS=1000
