# docker/alibaba_quorum_manager/alibaba_quorum_manager.env.example
#
# Example configuration for the Alibaba Cloud components
# (.kiro/specs/alibaba-cloud-services/, Requirement 18.1): one commented
# variable per field of alibaba_client_config,
# alibaba_ess_quorum_manager_config, and the OSS persistence engine's
# constructor. Copy, fill in, and source — nothing here is read
# automatically; these names match what the real-test suites read, so the
# same file drives a local run and a CI run.
#
# See docker/alibaba_quorum_manager/README.md for the prerequisite resources
# these settings point AT, which the code deliberately does not create.

# ── Credentials and region (alibaba_client_config) ───────────────────────────

# Region ID. Also folded into the OSS V4 signing scope, so it must match the
# bucket's region — a mismatch fails as SignatureDoesNotMatch, not as a
# helpful "wrong region" error.
KYTHIRA_ALIBABA_REGION=ap-southeast-1

# RAM AccessKey pair, or the temporary pair from an STS exchange.
KYTHIRA_ALIBABA_ACCESS_KEY_ID=
KYTHIRA_ALIBABA_ACCESS_KEY_SECRET=

# STS security token. Set ONLY with temporary credentials; when non-empty it
# is sent as x-acs-security-token (control plane) / x-oss-security-token
# (OSS) and included in the signed header set. Leave empty for a long-lived
# AccessKey pair.
KYTHIRA_ALIBABA_SECURITY_TOKEN=

# ── ESS quorum manager (alibaba_ess_quorum_manager_config) ───────────────────

# An EXISTING scaling group. The manager never creates, deletes or resizes
# the group's bounds — it only moves DesiredCapacity between them.
KYTHIRA_ALIBABA_SCALING_GROUP_ID=

# Tag value isolating this cluster's instances within the group. Instances
# tagged for a different cluster are never counted, tagged, or removed.
# KYTHIRA_ALIBABA_CLUSTER_NAME=kythira

# Port composed into peer addresses (peer_info's "<private-ip>:<port>").
# KYTHIRA_ALIBABA_NODE_PORT=7000

# ── OSS persistence engine ───────────────────────────────────────────────────

# An EXISTING bucket, in the same region as above.
KYTHIRA_ALIBABA_OSS_BUCKET=

# Key prefix owned exclusively by ONE process. The engine provides no
# fencing: two processes sharing a prefix will corrupt each other's state,
# exactly as two processes sharing file_persistence_engine's directory would.
# KYTHIRA_ALIBABA_OSS_PREFIX=raft
