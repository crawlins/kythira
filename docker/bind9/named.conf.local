// Dynamic updates must be signed with the TSIG key entrypoint.sh generates
// at start (key "kythira-update."). The zone used to accept unsigned
// RFC 2136 updates from every RFC 1918 address, so anything that could
// reach the container on a private network could rewrite the records the
// discovery nodes read.
include "/etc/bind/tsig.key";

zone "example.local" {
    type master;
    file "/var/lib/bind/db.example.local";
    allow-update { key "kythira-update."; };
};
