# Sample EnvironmentFile for a kythira node driving Azure capacity through
# either `kythira::azure_vm_quorum_manager` (direct ARM virtualMachines
# PUT/DELETE) or `kythira::azure_vmss_quorum_manager` (Flexible scale-set
# `sku.capacity`). Copy to /etc/default/azure_quorum_manager and fill in the
# IDs for your own subscription. Pick ONE manager: fill in the shared
# `azure_client_config` block, then either the VM block or the VMSS block.
#
# Every variable below maps to exactly one field of
# `kythira::azure_client_config` (include/raft/azure_client_config.hpp),
# `kythira::azure_vm_quorum_manager_config`
# (include/raft/azure_vm_quorum_manager.hpp) or
# `kythira::azure_vmss_quorum_manager_config`
# (include/raft/azure_vmss_quorum_manager.hpp), named in the comment above
# it. Nothing here is read by the library itself — the library takes a
# populated struct — so this file is the documented contract between your
# deployment's config loader and those structs. The field names are spelled
# out so a rename shows up as a diff in both places, and
# scripts/check-cloud-env-examples.py fails the docs CI job when a field is
# added, renamed or removed without this file following.
#
# List-valued variables are comma-separated. Map-valued variables are
# comma-separated `key=value` pairs whose key is a topology group id. For
# Azure the group id is conventionally the zone number ("1", "2", "3").
#
# See ./README.md for the resources these settings point AT, which the
# library deliberately does not create.

# ── azure_client_config (shared by both managers) ────────────────────────────

# azure_client_config::subscription_id — subscription GUID. Required.
KYTHIRA_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# azure_client_config::resource_group — the ONE resource group every managed
# VM, NIC and scale set lives in. Required.
KYTHIRA_AZURE_RESOURCE_GROUP=kythira-prod

# azure_client_config::location — region, e.g. eastus. Required.
KYTHIRA_AZURE_LOCATION=eastus

# azure_client_config::arm_endpoint_override — replaces
# https://management.azure.com. Empty in production. Must be HTTPS: the
# SDK's bearer-token policy refuses a plain-HTTP endpoint.
KYTHIRA_AZURE_ARM_ENDPOINT_OVERRIDE=

# azure_client_config::api_timeout — seconds per ARM call.
KYTHIRA_AZURE_API_TIMEOUT_SECONDS=30

# azure_client_config::credential — NOT settable from this file; it is an
# SDK object your loader may construct. Left null, the managers use
# `make_default_credential_chain()`: a service principal from the SDK's own
# variables below, then an `az login` session. Managed identity is
# deliberately NOT in that chain (azure-identity-cpp 1.13.2 segfaults when
# IMDS is unreachable); on Azure-hosted compute, construct a
# ManagedIdentityCredential yourself and set it here.
#
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# azure_client_config::transport — NOT settable from this file. A test-only
# hook for pointing a manager at a local HTTPS double; leave null.

# ═════════════════════════════════════════════════════════════════════════════
# Option A: azure_vm_quorum_manager — creates and deletes VMs itself
# ═════════════════════════════════════════════════════════════════════════════

# azure_vm_quorum_manager_config::azure — the azure_client_config block
# above.

# azure_vm_quorum_manager_config::cluster_name — the `kythira:cluster` tag
# value and the VM-name prefix (VMs are named kythira-<cluster>-<node-id>).
# Required.
KYTHIRA_AZURE_CLUSTER_NAME=kythira-prod

# azure_vm_quorum_manager_config::image_reference — the OS image. Set
# EITHER all four Marketplace parts OR the gallery image id, never both and
# never neither; the constructor rejects anything else.
#   azure_image_reference::publisher, azure_image_reference::offer,
#   azure_image_reference::sku, azure_image_reference::version
#   azure_image_reference::shared_gallery_image_id — an image VERSION id.
# Most cheap modern VM sizes are Hyper-V Gen2-only, so pick a -gen2 SKU;
# a Gen1 image on a Gen2-only size fails the create with BadRequest.
KYTHIRA_AZURE_IMAGE_PUBLISHER=Canonical
KYTHIRA_AZURE_IMAGE_OFFER=0001-com-ubuntu-server-jammy
KYTHIRA_AZURE_IMAGE_SKU=22_04-lts-gen2
KYTHIRA_AZURE_IMAGE_VERSION=latest
KYTHIRA_AZURE_SHARED_GALLERY_IMAGE_ID=

# azure_vm_quorum_manager_config::vm_size — the struct defaults to
# Standard_D2s_v5, which is restricted (NotAvailableForSubscription) in
# some subscriptions. Check `az vm list-skus -l <location> --size <size>`
# before relying on any size.
KYTHIRA_AZURE_VM_SIZE=Standard_D2s_v7

# azure_vm_quorum_manager_config::admin_username — Linux admin user.
KYTHIRA_AZURE_ADMIN_USERNAME=kythira

# azure_vm_quorum_manager_config::ssh_public_key — the key MATERIAL
# ("ssh-ed25519 AAAA…"), not a path. Effectively required: with neither a
# key nor a password ARM refuses every Linux VM create.
KYTHIRA_AZURE_SSH_PUBLIC_KEY=

# azure_vm_quorum_manager_config::subnet_id_by_group — full ARM subnet
# resource id per topology group, as group=id pairs. Every topology group
# needs an entry or the constructor throws. One subnet may serve every
# group: Azure subnets span the region's zones.
KYTHIRA_AZURE_SUBNET_ID_BY_GROUP=1=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/kythira-prod/providers/Microsoft.Network/virtualNetworks/kythira/subnets/nodes,2=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/kythira-prod/providers/Microsoft.Network/virtualNetworks/kythira/subnets/nodes,3=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/kythira-prod/providers/Microsoft.Network/virtualNetworks/kythira/subnets/nodes

# azure_vm_quorum_manager_config::network_security_group_id — NSG ARM id
# associated with every NIC. Empty = no NIC-level NSG.
KYTHIRA_AZURE_NETWORK_SECURITY_GROUP_ID=

# azure_vm_quorum_manager_config::node_port — the port the kythira process
# listens on; appended to the VM's private IP. Must be non-zero.
KYTHIRA_AZURE_NODE_PORT=7000

# azure_vm_quorum_manager_config::custom_data_template — cloud-init custom
# data. {NODE_ID}, {NODE_PORT}, {CLUSTER} and {GROUP} are substituted before
# the create (ARM makes the caller pick the VM name, so the node id is known
# up front, unlike on AWS). Empty = no custom data.
KYTHIRA_AZURE_CUSTOM_DATA_TEMPLATE=

# azure_vm_quorum_manager_config::topology — target voting-node count per
# group, as group=count pairs.
KYTHIRA_AZURE_TOPOLOGY=1=1,2=1,3=1

# azure_vm_quorum_manager_config::placement_by_group — per-group placement,
# as group=kind:value pairs (azure_placement_config), where kind is one of
#   zone:<n>         azure_placement_config::zone — Availability Zone 1/2/3
#   ppg:<arm-id>     azure_placement_config::resource_id — an existing
#                    Proximity Placement Group
#   avset:<arm-id>   azure_placement_config::resource_id — an existing
#                    managed Availability Set
# and azure_placement_config::kind is chosen by the prefix. Groups absent
# here get no explicit placement: Azure picks freely within the region, so
# a "zone 1" group id means nothing unless it is mapped here.
KYTHIRA_AZURE_PLACEMENT_BY_GROUP=1=zone:1,2=zone:2,3=zone:3

# azure_vm_quorum_manager_config::priority — regular|spot.
KYTHIRA_AZURE_PRIORITY=regular

# azure_vm_quorum_manager_config::spot_options — consulted only when
# priority=spot (azure_spot_options).
#   azure_spot_options::max_price — USD/hour; -1 = up to on-demand price.
#   azure_spot_options::eviction_policy — deallocate|delete_vm. Deallocate
#   keeps billing the disk; delete_vm frees everything.
KYTHIRA_AZURE_SPOT_MAX_PRICE=-1
KYTHIRA_AZURE_SPOT_EVICTION_POLICY=deallocate

# azure_vm_quorum_manager_config::provision_timeout — seconds to wait for a
# new VM to reach PowerState/running.
KYTHIRA_AZURE_PROVISION_TIMEOUT_SECONDS=300

# azure_vm_quorum_manager_config::poll_interval — milliseconds between
# instanceView polls while provisioning.
KYTHIRA_AZURE_POLL_INTERVAL_MS=5000

# azure_vm_quorum_manager_config::extra_tags — additional ARM tags on every
# VM, as key=value pairs. Never reuse a `kythira:` key: extra tags are
# written after the standard ones and would overwrite, say, kythira:node-id,
# after which the manager cannot find its own node.
KYTHIRA_AZURE_EXTRA_TAGS=owner=platform-team,environment=prod

# ═════════════════════════════════════════════════════════════════════════════
# Option B: azure_vmss_quorum_manager — moves scale-set capacity
# ═════════════════════════════════════════════════════════════════════════════
#
# Image, size, zones, priority and custom data live on the operator-created
# scale sets' own model. KYTHIRA_AZURE_CLUSTER_NAME, KYTHIRA_AZURE_NODE_PORT,
# KYTHIRA_AZURE_TOPOLOGY and the provisioning timing variables above carry
# over unchanged:
#
# azure_vmss_quorum_manager_config::azure — the azure_client_config block.
# azure_vmss_quorum_manager_config::cluster_name — KYTHIRA_AZURE_CLUSTER_NAME.
# azure_vmss_quorum_manager_config::node_port — KYTHIRA_AZURE_NODE_PORT.
# azure_vmss_quorum_manager_config::topology — KYTHIRA_AZURE_TOPOLOGY.
# azure_vmss_quorum_manager_config::provision_timeout — seconds to wait for
#   the new member to be running and found untagged.
# azure_vmss_quorum_manager_config::poll_interval — milliseconds between
#   member-list polls.

# azure_vmss_quorum_manager_config::scale_set_by_group — the scale set that
# owns each topology group, as group=vmss-name pairs (names, not ids; they
# live in the resource group above). Must be non-empty and cover every
# topology group. Every scale set must use Flexible orchestration (a Uniform
# member cannot carry its own kythira:node-id tag) and must NOT use
# upgradePolicy.mode=Automatic (it replaces instances behind the manager's
# back). The constructor refuses either. Pin each scale set to one zone so
# the group id means where the node lands.
KYTHIRA_AZURE_SCALE_SET_BY_GROUP=1=kythira-prod-z1,2=kythira-prod-z2,3=kythira-prod-z3

# azure_vmss_quorum_manager_config::decommission_timeout — seconds to wait
# for a deleted member to stop being listed. A Flexible member stays listed
# as Deleting for minutes; 600 is measured, not padded.
KYTHIRA_AZURE_VMSS_DECOMMISSION_TIMEOUT_SECONDS=600
