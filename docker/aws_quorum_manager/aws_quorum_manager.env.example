# Sample EnvironmentFile for a kythira node driving AWS EC2 capacity through
# either `kythira::aws_ec2_quorum_manager` (direct RunInstances/Terminate)
# or `kythira::aws_asg_quorum_manager` (Auto Scaling Group desired capacity).
# Copy to /etc/default/aws_quorum_manager and fill in the IDs for your own
# account. Pick ONE manager: fill in the shared `aws_client_config` block,
# then either the EC2 block or the ASG block.
#
# Every variable below maps to exactly one field of
# `kythira::aws_client_config` (include/raft/aws_client_config.hpp),
# `kythira::aws_ec2_quorum_manager_config`
# (include/raft/aws_ec2_quorum_manager.hpp) or
# `kythira::aws_asg_quorum_manager_config`
# (include/raft/aws_asg_quorum_manager.hpp), named in the comment above it.
# Nothing here is read by the library itself — the library takes a
# populated struct — so this file is the documented contract between your
# deployment's config loader and those structs. The field names are spelled
# out so a rename shows up as a diff in both places, and
# scripts/check-cloud-env-examples.py fails the docs CI job when a field is
# added, renamed or removed without this file following.
#
# List-valued variables are comma-separated. Map-valued variables are
# comma-separated `key=value` pairs whose key is a topology group id. For
# AWS the group id is conventionally the Availability Zone name.
#
# See ./README.md for the resources these settings point AT, which the
# library deliberately does not create.

# ── aws_client_config (shared by both managers) ──────────────────────────────

# aws_client_config::region — region string. Empty falls back to the SDK
# default chain, which reads $AWS_REGION / $AWS_DEFAULT_REGION and then
# ~/.aws/config. Setting it here makes the region explicit in one place.
KYTHIRA_AWS_REGION=us-east-1

# aws_client_config::endpoint_override — replaces the EC2 and Auto Scaling
# endpoint. Empty in production; the tests use it to point at LocalStack
# (docker/aws-localstack-compose.yml).
KYTHIRA_AWS_ENDPOINT_OVERRIDE=

# aws_client_config::api_timeout — seconds. Bounds both the connect and the
# request phase of a single AWS API call.
KYTHIRA_AWS_API_TIMEOUT_SECONDS=30

# aws_client_config::credentials_provider — NOT settable from this file; it
# is an SDK object your loader may construct. Leave it null to use the
# SDK's DefaultAWSCredentialsProviderChain, which reads the SDK's own
# variables below (environment, then ~/.aws, then the instance profile).
# On an EC2 node, prefer the instance profile and set none of these.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

# ═════════════════════════════════════════════════════════════════════════════
# Option A: aws_ec2_quorum_manager — launches and terminates instances itself
# ═════════════════════════════════════════════════════════════════════════════

# aws_ec2_quorum_manager_config::cluster_name — written to the
# `kythira:cluster` tag on every managed instance; scopes every lookup.
# Required.
KYTHIRA_AWS_CLUSTER_NAME=kythira-prod

# aws_ec2_quorum_manager_config::image_id — AMI every node boots from. It
# must already contain the kythira node binary and start it at boot (see
# packer/ca_cluster_node/ for a scripted AMI). Required.
KYTHIRA_AWS_EC2_IMAGE_ID=ami-0123456789abcdef0

# aws_ec2_quorum_manager_config::instance_type — default t3.micro.
KYTHIRA_AWS_EC2_INSTANCE_TYPE=t3.micro

# aws_ec2_quorum_manager_config::node_port — the port the kythira process
# listens on; appended to the instance's private IP to form the address
# `provision_node` returns. Must be non-zero.
KYTHIRA_AWS_NODE_PORT=7000

# aws_ec2_quorum_manager_config::topology — target voting-node count per
# group, as group=count pairs. Must be non-empty. Three AZs with one voter
# each survives the loss of any one AZ.
KYTHIRA_AWS_TOPOLOGY=us-east-1a=1,us-east-1b=1,us-east-1c=1

# aws_ec2_quorum_manager_config::subnet_by_group — the subnet each group's
# nodes launch into, as group=subnet-id pairs. Every topology group needs an
# entry or the constructor throws. The subnet's AZ IS the node's AZ, so map
# each group to a subnet in the AZ of the same name.
KYTHIRA_AWS_EC2_SUBNET_BY_GROUP=us-east-1a=subnet-0aaaaaaaaaaaaaaaa,us-east-1b=subnet-0bbbbbbbbbbbbbbbb,us-east-1c=subnet-0cccccccccccccccc

# aws_ec2_quorum_manager_config::security_group_ids — applied to every
# instance. Must admit node_port from the other nodes.
KYTHIRA_AWS_EC2_SECURITY_GROUP_IDS=sg-0123456789abcdef0

# aws_ec2_quorum_manager_config::iam_instance_profile — instance-profile
# NAME (not ARN) attached to each node. Empty = none. The manager's own
# principal then needs iam:PassRole on the profile's role.
KYTHIRA_AWS_EC2_IAM_INSTANCE_PROFILE=

# aws_ec2_quorum_manager_config::key_name — EC2 key pair for SSH. Empty
# (the default) attaches none; reach nodes through SSM instead.
KYTHIRA_AWS_EC2_KEY_NAME=

# aws_ec2_quorum_manager_config::user_data_template — user data for every
# node. {NODE_PORT}, {CLUSTER} and {AZ} are substituted before launch.
# {NODE_ID} is NOT: the node id is derived from the instance id, which does
# not exist until RunInstances returns, so the token reaches the instance
# verbatim. Have the node read its own id from the `kythira:node-id` tag or
# the instance-metadata instance id instead. Empty = no user data.
KYTHIRA_AWS_EC2_USER_DATA_TEMPLATE=

# aws_ec2_quorum_manager_config::extra_tags — additional tags merged onto
# every instance, as key=value pairs. The standard kythira:* tags are
# applied alongside these, so never reuse a `kythira:` key here: EC2
# rejects a launch that names one tag key twice.
KYTHIRA_AWS_EC2_EXTRA_TAGS=owner=platform-team,environment=prod

# aws_ec2_quorum_manager_config::placement_by_group — optional EC2 placement
# group per topology group, as group=name:strategy:partition triples:
#   ec2_placement_group_config::name — an EXISTING placement group.
#   ec2_placement_group_config::strategy — cluster|spread|partition, the
#     strategy the group was created with (ec2_placement_group_strategy).
#   ec2_placement_group_config::partition_number — 1-based partition, 0 to
#     let EC2 choose; only meaningful for `partition`. Groups absent here get none. Prefer
# `spread` for voters: `cluster` puts every voter on one rack.
KYTHIRA_AWS_EC2_PLACEMENT_BY_GROUP=

# aws_ec2_quorum_manager_config::spot_options — set to launch every node as
# a Spot instance (ec2_spot_options). Unset = on-demand. Spot voters can be
# reclaimed at two minutes' notice; losing a majority at once loses quorum,
# so keep at least a majority on-demand or spread them across AZs.
#   ec2_spot_options::max_price — USD/hour; empty = current Spot price.
#   ec2_spot_options::interruption_behavior — terminate|stop|hibernate.
KYTHIRA_AWS_EC2_SPOT=false
KYTHIRA_AWS_EC2_SPOT_MAX_PRICE=
KYTHIRA_AWS_EC2_SPOT_INTERRUPTION_BEHAVIOR=terminate

# aws_ec2_quorum_manager_config::require_imdsv2 — launch nodes with
# HttpTokens=required so instance metadata, and the instance profile's
# credentials, answer only IMDSv2 token requests. A server-side request
# forgery on a node then cannot fetch them with a plain GET. Default true;
# false leaves the AMI and account defaults in place.
KYTHIRA_AWS_EC2_REQUIRE_IMDSV2=true

# aws_ec2_quorum_manager_config::imds_hop_limit — IMDSv2 token response hop
# limit, 1-64. Empty = the AMI or account default (usually 1). Set 2 when the
# node runs in a container on a bridge network.
KYTHIRA_AWS_EC2_IMDS_HOP_LIMIT=

# aws_ec2_quorum_manager_config::provision_timeout — seconds to wait for a
# launched instance to reach `running`.
KYTHIRA_AWS_PROVISION_TIMEOUT_SECONDS=120

# aws_ec2_quorum_manager_config::poll_interval — seconds between
# DescribeInstances polls while provisioning.
KYTHIRA_AWS_POLL_INTERVAL_SECONDS=5

# aws_ec2_quorum_manager_config::aws — the aws_client_config block above.

# ═════════════════════════════════════════════════════════════════════════════
# Option B: aws_asg_quorum_manager — moves Auto Scaling Group capacity
# ═════════════════════════════════════════════════════════════════════════════
#
# The launch template, instance type, subnets and security groups all live
# on the operator-created ASGs, so this block is short.
# KYTHIRA_AWS_CLUSTER_NAME, KYTHIRA_AWS_NODE_PORT, KYTHIRA_AWS_TOPOLOGY and
# the two timing variables above carry over unchanged:
#
# aws_asg_quorum_manager_config::cluster_name — KYTHIRA_AWS_CLUSTER_NAME.
# aws_asg_quorum_manager_config::node_port — KYTHIRA_AWS_NODE_PORT.
# aws_asg_quorum_manager_config::topology — KYTHIRA_AWS_TOPOLOGY.
# aws_asg_quorum_manager_config::provision_timeout — seconds to wait for the
#   new instance to be InService with a private IP. On expiry the manager
#   restores the group's previous desired capacity.
# aws_asg_quorum_manager_config::poll_interval — seconds between ASG polls.
# aws_asg_quorum_manager_config::aws — the aws_client_config block above.

# aws_asg_quorum_manager_config::asg_by_group — the ASG that owns each
# topology group, as group=asg-name pairs. Must be non-empty and cover every
# topology group. Every ASG named here must use HealthCheckType=EC2 (the
# constructor refuses ELB health checks: the ASG and kythira must agree on
# which instances are healthy, or the ASG replaces a voter kythira still
# counts). Give each ASG subnets in ONE AZ only, so the group id means where
# the node actually lands.
KYTHIRA_AWS_ASG_BY_GROUP=us-east-1a=kythira-prod-a,us-east-1b=kythira-prod-b,us-east-1c=kythira-prod-c
