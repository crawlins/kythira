# Sample EnvironmentFile for a kythira node driving Google Compute Engine
# capacity through either `kythira::gcp_compute_quorum_manager` (direct
# instances.insert/delete) or `kythira::gcp_mig_quorum_manager` (zonal
# Managed Instance Group resize). Copy to /etc/default/gcp_quorum_manager
# and fill in the names for your own project. Pick ONE manager: fill in the
# shared `gcp_client_config` block, then either the GCE block or the MIG
# block.
#
# Every variable below maps to exactly one field of
# `kythira::gcp_client_config` (include/raft/gcp_client_config.hpp),
# `kythira::gcp_compute_quorum_manager_config`
# (include/raft/gcp_compute_quorum_manager.hpp) or
# `kythira::gcp_mig_quorum_manager_config`
# (include/raft/gcp_mig_quorum_manager.hpp), named in the comment above it.
# Nothing here is read by the library itself — the library takes a
# populated struct — so this file is the documented contract between your
# deployment's config loader and those structs. The field names are spelled
# out so a rename shows up as a diff in both places, and
# scripts/check-cloud-env-examples.py fails the docs CI job when a field is
# added, renamed or removed without this file following.
#
# List-valued variables are comma-separated. Map-valued variables are
# comma-separated `key=value` pairs whose key is a topology group id. For
# GCP the group id IS the zone name: the managers place each group's nodes
# in the zone it names.
#
# See ./README.md for the resources these settings point AT, which the
# library deliberately does not create, and doc/gcp_quorum_manager_README.md
# for the design (node identity, labels, the MIG autohealing guard).

# ── gcp_client_config (shared by both managers) ──────────────────────────────

# gcp_client_config::project_id — the project every instance and MIG lives
# in. Required.
KYTHIRA_GCP_PROJECT_ID=my-project

# gcp_client_config::credentials_json — an inline service-account JSON key,
# the key's CONTENT, not a path. Leave empty (recommended) to use
# Application Default Credentials: $GOOGLE_APPLICATION_CREDENTIALS, then
# gcloud's ADC file, then the GCE metadata server — which is what a node
# running on GCE with an attached service account uses, with no key at all.
# If you do set it, whatever holds this file is a secret: mode 0600.
#   KYTHIRA_GCP_CREDENTIALS_JSON="$(cat /etc/kythira/gcp-key.json)"
KYTHIRA_GCP_CREDENTIALS_JSON=

# gcp_client_config::endpoint_override — replaces the Compute REST
# endpoint. Empty in production; tests point it at a local double.
KYTHIRA_GCP_ENDPOINT_OVERRIDE=

# gcp_client_config::api_timeout — seconds for a single API call.
KYTHIRA_GCP_API_TIMEOUT_SECONDS=30

# gcp_client_config::operation_timeout — seconds the SDK may spend polling
# one long-running operation (insert, delete, resize). Deliberately much
# larger than api_timeout and NOT derived from it: GCE routinely takes more
# than 30 s to delete an instance, and capping the poll there made
# decommission_node fail on 2 of 3 live runs.
KYTHIRA_GCP_OPERATION_TIMEOUT_SECONDS=900

# gcp_client_config::operation_poll_interval — milliseconds between
# zoneOperations.get polls.
KYTHIRA_GCP_OPERATION_POLL_INTERVAL_MS=2000

# ═════════════════════════════════════════════════════════════════════════════
# Option A: gcp_compute_quorum_manager — inserts and deletes instances itself
# ═════════════════════════════════════════════════════════════════════════════

# gcp_compute_quorum_manager_config::gcp — the gcp_client_config block.

# gcp_compute_quorum_manager_config::cluster_name — the `kythira-cluster`
# label value and the instance-name prefix (instances are named
# kythira-<cluster>-<node-id>). It must be valid as both a label value and
# part of an instance name, so use only lowercase letters, digits and `-`,
# starting with a letter (a label would accept `_`; an instance name does
# not). Keep it to 34 characters or fewer: the constructor rejects any
# cluster name whose worst-case instance name, with a 20-digit node id,
# exceeds GCE's 63. Required.
KYTHIRA_GCP_CLUSTER_NAME=kythira-prod

# gcp_compute_quorum_manager_config::machine_type — short form; the manager
# zone-qualifies it.
KYTHIRA_GCP_MACHINE_TYPE=e2-medium

# gcp_compute_quorum_manager_config::boot_disk_image — any form
# instances.insert's sourceImage accepts: an image, or an image family
# (projects/<p>/global/images/family/<f>). Required.
KYTHIRA_GCP_BOOT_DISK_IMAGE=projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts

# gcp_compute_quorum_manager_config::boot_disk_size_gb — GiB.
KYTHIRA_GCP_BOOT_DISK_SIZE_GB=20

# gcp_compute_quorum_manager_config::network — VPC short name or self-link.
# A short name is expanded to global/networks/<name>.
KYTHIRA_GCP_NETWORK=default

# gcp_compute_quorum_manager_config::subnetwork_by_group — subnetwork per
# zone, as zone=subnetwork pairs. A short name is expanded to
# regions/<region>/subnetworks/<name>, the region taken from the zone.
# Every topology zone needs an entry or the constructor throws.
KYTHIRA_GCP_SUBNETWORK_BY_GROUP=us-central1-a=default,us-central1-b=default,us-central1-c=default

# gcp_compute_quorum_manager_config::service_account_email — service
# account attached to every instance. Empty = none. The manager's own
# principal needs roles/iam.serviceAccountUser on THIS account (grant it on
# the account, not project-wide).
KYTHIRA_GCP_SERVICE_ACCOUNT_EMAIL=

# gcp_compute_quorum_manager_config::service_account_scopes — OAuth scopes
# for that account.
KYTHIRA_GCP_SERVICE_ACCOUNT_SCOPES=https://www.googleapis.com/auth/cloud-platform

# gcp_compute_quorum_manager_config::node_port — the port the kythira
# process listens on; appended to the instance's internal IP. Non-zero.
KYTHIRA_GCP_NODE_PORT=7000

# gcp_compute_quorum_manager_config::startup_script_template — written to
# the `startup-script` metadata key. {NODE_ID}, {NODE_PORT}, {CLUSTER} and
# {ZONE} are substituted before the insert (kythira draws the node id
# itself, so it is known up front). Empty = no startup script.
KYTHIRA_GCP_STARTUP_SCRIPT_TEMPLATE=

# gcp_compute_quorum_manager_config::topology — target voting-node count
# per zone, as zone=count pairs.
KYTHIRA_GCP_TOPOLOGY=us-central1-a=1,us-central1-b=1,us-central1-c=1

# gcp_compute_quorum_manager_config::provision_timeout — seconds to wait
# for a new instance to reach RUNNING, after the insert operation is DONE.
KYTHIRA_GCP_PROVISION_TIMEOUT_SECONDS=300

# gcp_compute_quorum_manager_config::poll_interval — milliseconds between
# instances.get polls while provisioning.
KYTHIRA_GCP_POLL_INTERVAL_MS=5000

# gcp_compute_quorum_manager_config::placement_by_group — optional resource
# policy per zone, as zone=self-link[:collocated] pairs:
#   gcp_placement_policy_config::self_link — an EXISTING placement policy.
#   gcp_placement_policy_config::collocation — informational; true when the
#     policy is COLLOCATED. Sets the kythira-placement label to `compact`.
# Zones absent here get none. A COLLOCATED policy packs nodes onto close
# hardware: good for latency, bad for independent failure.
KYTHIRA_GCP_PLACEMENT_BY_GROUP=

# gcp_compute_quorum_manager_config::spot — true requests
# scheduling.provisioningModel=SPOT. Spot VMs can be preempted at any time;
# keep a majority of voters on standard VMs.
KYTHIRA_GCP_SPOT=false

# gcp_compute_quorum_manager_config::extra_labels — additional labels on
# every instance, as key=value pairs. Each key and value must be a valid
# GCP label or the constructor throws. They never override the six
# standard kythira-* labels.
KYTHIRA_GCP_EXTRA_LABELS=owner=platform-team,environment=prod

# ═════════════════════════════════════════════════════════════════════════════
# Option B: gcp_mig_quorum_manager — resizes zonal Managed Instance Groups
# ═════════════════════════════════════════════════════════════════════════════
#
# Machine type, image, network and service account live on the MIGs'
# instance template. KYTHIRA_GCP_CLUSTER_NAME, KYTHIRA_GCP_NODE_PORT,
# KYTHIRA_GCP_TOPOLOGY and the two provisioning timing variables above carry
# over unchanged:
#
# gcp_mig_quorum_manager_config::gcp — the gcp_client_config block.
# gcp_mig_quorum_manager_config::cluster_name — KYTHIRA_GCP_CLUSTER_NAME.
# gcp_mig_quorum_manager_config::node_port — KYTHIRA_GCP_NODE_PORT.
# gcp_mig_quorum_manager_config::topology — KYTHIRA_GCP_TOPOLOGY.
# gcp_mig_quorum_manager_config::provision_timeout — seconds to wait for the
#   new instance to appear and reach RUNNING.
# gcp_mig_quorum_manager_config::poll_interval — milliseconds between
#   listManagedInstances polls.

# gcp_mig_quorum_manager_config::mig_by_group — the ZONAL MIG that owns
# each zone, as zone=mig-name pairs. Must be non-empty and cover every
# topology zone. Every MIG must have NO autoHealingPolicies: an autohealer
# replacing VMs on its own health signal races kythira's remediation loop,
# and the constructor refuses such a MIG.
KYTHIRA_GCP_MIG_BY_GROUP=us-central1-a=kythira-prod-a,us-central1-b=kythira-prod-b,us-central1-c=kythira-prod-c
