[
  {
    "Sid": "AsgQuorumManagerDescribeNoResourceLevelPermissions",
    "Effect": "Allow",
    "Action": [
      "autoscaling:DescribeAutoScalingGroups",
      "autoscaling:DescribeAutoScalingInstances",
      "autoscaling:DescribeScalingActivities",
      "ec2:DescribeAvailabilityZones",
      "ec2:DescribeImages",
      "ec2:DescribeInstanceStatus",
      "ec2:DescribeInstances",
      "ec2:DescribeLaunchTemplateVersions",
      "ec2:DescribeLaunchTemplates",
      "ec2:DescribeSecurityGroups",
      "ec2:DescribeSubnets",
      "ec2:DescribeVpcs"
    ],
    "Resource": "*"
  },
  {
    "Sid": "AsgQuorumManagerMutateKythiraGroupsOnly",
    "Effect": "Allow",
    "Action": [
      "autoscaling:CreateAutoScalingGroup",
      "autoscaling:CreateOrUpdateTags",
      "autoscaling:DeleteAutoScalingGroup",
      "autoscaling:PutLifecycleHook",
      "autoscaling:SetDesiredCapacity",
      "autoscaling:SetInstanceProtection",
      "autoscaling:TerminateInstanceInAutoScalingGroup",
      "autoscaling:UpdateAutoScalingGroup"
    ],
    "Resource": "arn:aws:autoscaling:*:{{ACCOUNT_ID}}:autoScalingGroup:*:autoScalingGroupName/kythira-asgtest-*"
  },
  {
    "Sid": "AsgQuorumManagerCreateFixtureResourcesNotYetTaggable",
    "Effect": "Allow",
    "Action": [
      "ec2:CreateLaunchTemplate",
      "ec2:CreateSecurityGroup",
      "ec2:CreateSubnet",
      "ec2:CreateVpc",
      "ec2:RunInstances"
    ],
    "Resource": "*"
  },
  {
    "Sid": "AsgQuorumManagerStopAndTearDownSuiteTaggedOnly",
    "Effect": "Allow",
    "Action": [
      "ec2:CreateTags",
      "ec2:DeleteLaunchTemplate",
      "ec2:DeleteSecurityGroup",
      "ec2:DeleteSubnet",
      "ec2:DeleteVpc",
      "ec2:StopInstances",
      "ec2:TerminateInstances"
    ],
    "Resource": "*",
    "Condition": {
      "StringEquals": {
        "aws:ResourceTag/kythira:suite": "aws-asg-quorum-manager"
      }
    }
  },
  {
    "Sid": "Ec2TagOnCreate",
    "Effect": "Allow",
    "Action": "ec2:CreateTags",
    "Resource": "*",
    "Condition": {
      "StringEquals": {
        "ec2:CreateAction": [
          "AllocateAddress",
          "CreateImage",
          "CreateInternetGateway",
          "CreateKeyPair",
          "CreateLaunchTemplate",
          "CreateNatGateway",
          "CreateNetworkAcl",
          "CreatePlacementGroup",
          "CreateRouteTable",
          "CreateSecurityGroup",
          "CreateSnapshot",
          "CreateSubnet",
          "CreateVolume",
          "CreateVpc",
          "RunInstances"
        ]
      }
    }
  },
  {
    "Sid": "Ec2TagExistingNonInstanceResources",
    "Effect": "Allow",
    "Action": "ec2:CreateTags",
    "NotResource": "arn:aws:ec2:*:{{ACCOUNT_ID}}:instance/*",
    "Condition": {
      "ForAllValues:StringNotEquals": {
        "aws:TagKeys": [
          "kythira:suite"
        ]
      }
    }
  }
]
