[
  {
    "Sid": "PerfCloudInstanceLifecycle",
    "Effect": "Allow",
    "Action": [
      "ec2:RunInstances",
      "ec2:TerminateInstances",
      "ec2:CreateTags"
    ],
    "Resource": "*"
  },
  {
    "Sid": "PerfCloudDescribeForProvisioning",
    "Effect": "Allow",
    "Action": [
      "ec2:DescribeInstances",
      "ec2:DescribeInstanceStatus",
      "ec2:DescribeInstanceTypes",
      "ec2:DescribeImages",
      "ec2:DescribeSubnets",
      "ec2:DescribeVpcs",
      "ec2:DescribeAvailabilityZones",
      "ec2:DescribeInstanceTypeOfferings"
    ],
    "Resource": "*"
  },
  {
    "Sid": "PerfCloudDescribeForLeakAudit",
    "Effect": "Allow",
    "Action": [
      "ec2:DescribeVolumes",
      "ec2:DescribeAddresses",
      "ec2:DescribeSecurityGroups",
      "ec2:DescribePlacementGroups",
      "ec2:DescribeKeyPairs",
      "ec2:DescribeTags"
    ],
    "Resource": "*"
  },
  {
    "Sid": "PerfCloudResolveUbuntuAmiFromSsmPublicParameters",
    "Effect": "Allow",
    "Action": [
      "ssm:GetParameter",
      "ssm:GetParameters"
    ],
    "Resource": "arn:aws:ssm:*::parameter/aws/service/canonical/*"
  }
]
