[
  {
    "Sid": "PerfCloudInstanceLifecycle",
    "Effect": "Allow",
    "Action": [
      "ec2:RunInstances"
    ],
    "Resource": "*"
  },
  {
    "Sid": "PerfCloudInstancesOwnedOnly",
    "Effect": "Allow",
    "Action": [
      "ec2:CreateTags",
      "ec2:TerminateInstances"
    ],
    "Resource": "arn:aws:ec2:*:{{ACCOUNT_ID}}:instance/*",
    "Condition": {
      "Null": {
        "aws:ResourceTag/kythira-perf-run": "false"
      }
    }
  },
  {
    "Sid": "Ec2TagOnCreate",
    "Effect": "Allow",
    "Action": "ec2:CreateTags",
    "Resource": "*",
    "Condition": {
      "StringEquals": {
        "ec2:CreateAction": [
          "AllocateAddress",
          "CreateImage",
          "CreateInternetGateway",
          "CreateKeyPair",
          "CreateLaunchTemplate",
          "CreateNatGateway",
          "CreateNetworkAcl",
          "CreatePlacementGroup",
          "CreateRouteTable",
          "CreateSecurityGroup",
          "CreateSnapshot",
          "CreateSubnet",
          "CreateVolume",
          "CreateVpc",
          "RunInstances"
        ]
      }
    }
  },
  {
    "Sid": "Ec2TagExistingNonInstanceResources",
    "Effect": "Allow",
    "Action": "ec2:CreateTags",
    "NotResource": "arn:aws:ec2:*:{{ACCOUNT_ID}}:instance/*",
    "Condition": {
      "ForAllValues:StringNotEquals": {
        "aws:TagKeys": [
          "kythira:suite"
        ]
      }
    }
  },
  {
    "Sid": "PerfCloudEphemeralAccessPath",
    "Effect": "Allow",
    "Action": [
      "ec2:CreateKeyPair",
      "ec2:DeleteKeyPair",
      "ec2:CreateSecurityGroup",
      "ec2:DeleteSecurityGroup",
      "ec2:AuthorizeSecurityGroupIngress",
      "ec2:RevokeSecurityGroupIngress",
      "ec2:CreatePlacementGroup",
      "ec2:DeletePlacementGroup"
    ],
    "Resource": "*"
  },
  {
    "Sid": "PerfCloudDescribeForProvisioning",
    "Effect": "Allow",
    "Action": [
      "ec2:DescribeInstances",
      "ec2:DescribeInstanceStatus",
      "ec2:DescribeInstanceTypes",
      "ec2:DescribeImages",
      "ec2:DescribeSubnets",
      "ec2:DescribeVpcs",
      "ec2:DescribeAvailabilityZones",
      "ec2:DescribeInstanceTypeOfferings",
      "ec2:GetConsoleOutput"
    ],
    "Resource": "*"
  },
  {
    "Sid": "PerfCloudDescribeForLeakAudit",
    "Effect": "Allow",
    "Action": [
      "ec2:DescribeVolumes",
      "ec2:DescribeAddresses",
      "ec2:DescribeSecurityGroups",
      "ec2:DescribePlacementGroups",
      "ec2:DescribeKeyPairs",
      "ec2:DescribeTags"
    ],
    "Resource": "*"
  },
  {
    "Sid": "PerfCloudResolveUbuntuAmiFromSsmPublicParameters",
    "Effect": "Allow",
    "Action": [
      "ssm:GetParameter",
      "ssm:GetParameters"
    ],
    "Resource": "arn:aws:ssm:*::parameter/aws/service/canonical/*"
  }
]
