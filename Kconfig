mainmenu "Kythira Build Configuration"

config COVERAGE
	bool "Source-based coverage instrumentation"
	default n
	help
	  Mirrors the existing ENABLE_COVERAGE CMake option. Requires Clang;
	  forces CMAKE_BUILD_TYPE=Debug. See cmake/Kconfig.cmake for how this
	  symbol continues to set the legacy ENABLE_COVERAGE cache variable
	  so `cmake --build build --target coverage` keeps working unchanged.

menu "Transports"

config OPENSSL
	bool "OpenSSL (TLS/HTTPS support)"
	default y
	help
	  find_package(OpenSSL). Backs KYTHIRA_HAS_OPENSSL and, combined with
	  HTTP_TRANSPORT, CPPHTTPLIB_OPENSSL_SUPPORT. vcpkg package: openssl.

config HTTP_TRANSPORT
	bool "HTTP transport (cpp-httplib)"
	default y
	help
	  find_package(httplib). vcpkg package: cpp-httplib.

config HTTP_TRANSPORT_TLS
	bool "HTTPS support for HTTP transport"
	depends on HTTP_TRANSPORT && OPENSSL
	default y
	help
	  Defines CPPHTTPLIB_OPENSSL_SUPPORT, enabling httplib::SSLServer/
	  SSLClient and ca_service --serve's --tls-cert/--tls-key mode.

config BOOST_BEAST_TRANSPORT
	bool "Boost.Beast HTTP transport (second implementation, alongside cpp-httplib)"
	default n
	help
	  Adds a second network_client/network_server implementation backed by
	  Boost.Beast, satisfying the same concepts as HTTP_TRANSPORT's
	  cpp-httplib backend (include/raft/http_transport.hpp) without
	  replacing it. boost-beast is always vcpkg-installed regardless of
	  this symbol (header-only, low-cost, same treatment as stdexec in the
	  Futures menu below) -- this only controls whether this project's own
	  beast_http_transport.hpp targets/tests are built. Uses Boost.Beast's
	  asynchronous API driven by a caller-owned net::io_context, a
	  genuinely new I/O model for this codebase (every other transport
	  uses blocking calls dispatched onto an executor instead) -- see
	  .kiro/specs/boost-beast-http-transport/ for the full design,
	  including why.

config PROXYGEN_TRANSPORT
	bool "Proxygen HTTP transport (third implementation, alongside cpp-httplib and Beast)"
	default n
	depends on FOLLY
	help
	  Adds a third network_client/network_server implementation backed by
	  Meta's Proxygen library, satisfying the same concepts as the existing
	  cpp-httplib (include/raft/http_transport.hpp) and Boost.Beast
	  (include/raft/beast_http_transport.hpp) transports without replacing
	  either. Requires the proxygen vcpkg package, which itself
	  unconditionally depends on folly -- unlike most CONFIG_X=n
	  combinations in this project, CONFIG_PROXYGEN_TRANSPORT=y with
	  CONFIG_FOLLY=n is not a valid, degraded-but-buildable configuration.
	  See .kiro/specs/proxygen-http-transport/ for the full design,
	  including the optional Folly-native fast path this feature adds when
	  both this and CONFIG_FOLLY (as the selected default backend) are
	  active.

config COAP_TRANSPORT
	bool "CoAP transport"
	default y
	help
	  Whether to build the CoAP transport at all. This is the *feature*
	  symbol, not a backend: n means no CoAP target is created anywhere,
	  including its 45 test binaries. y means the transport is built, and
	  which wire implementation it gets is chosen by the backend symbols
	  below.

	  y with every backend n is a supported configuration, not an
	  accident: it builds the backend-free surface -- the concept
	  conformance, config, message-construction and content-format tests
	  that need no library at all. Compiling that surface has caught real
	  bugs, which is why it is reachable deliberately rather than only
	  when a library happens to be missing from the host.

	  Until August 10, 2026 this symbol also *was* the libcoap backend,
	  and setting it n disabled nothing whatsoever -- the CoAP targets
	  were gated on Folly instead and were never wired to it.

config COAP_BACKEND_LIBCOAP
	bool "libcoap backend (DTLS)"
	depends on COAP_TRANSPORT
	default y
	help
	  find_package(libcoap CONFIG) or PkgConfig fallback (libcoap-3).
	  Backs LIBCOAP_AVAILABLE. vcpkg package: libcoap (feature: dtls).

	  Defaults y because libcoap is the original and default backend, so
	  a build that says nothing about backends keeps getting it. Split
	  out of COAP_TRANSPORT so that the three backends are symmetrical:
	  this, COAP_TRANSPORT_LIBNYOCI and COAP_TRANSPORT_CANTCOAP are now
	  the same kind of thing and can each be turned off independently of
	  whether the transport itself is built.

config COAP_TRANSPORT_LIBNYOCI
	bool "Alternate CoAP transport backend (libnyoci)"
	default n
	help
	  pkg_check_modules(LIBNYOCI libnyoci). Backs LIBNYOCI_AVAILABLE,
	  enabling coap_libnyoci_client/coap_libnyoci_server
	  (include/raft/coap_transport_libnyoci_impl.hpp) — a second
	  implementation of the network_client/network_server concepts
	  speaking CoAP over libnyoci instead of libcoap. vcpkg feature:
	  coap-libnyoci (vcpkg-overlays/libnyoci overlay port; not built by
	  default). Additive, not a replacement: it does not depend on
	  COAP_TRANSPORT and the two backends coexist at link time.
	  Defaults to n because the overlay port needs the autotools chain
	  plus autoconf-archive on the host; strict mode will fail configure
	  if you select y without libnyoci installed. See
	  .kiro/specs/coap-transport-libnyoci/ for the full design.

config COAP_TRANSPORT_CANTCOAP
	bool "Alternate CoAP transport backend (cantcoap)"
	default n
	help
	  find_package(cantcoap CONFIG). Backs CANTCOAP_AVAILABLE, enabling
	  coap_cantcoap_client/coap_cantcoap_server
	  (include/raft/coap_transport_cantcoap_impl.hpp) — a third
	  implementation of the network_client/network_server concepts.
	  cantcoap is a CoAP *message codec* only: it builds and parses PDUs
	  and provides no socket, no retransmission, no block-wise and no
	  DTLS, so this backend supplies all of that itself around it. vcpkg
	  feature: coap-cantcoap (vcpkg-overlays/cantcoap overlay port; not
	  built by default). Additive, not a replacement: independent of
	  COAP_TRANSPORT and COAP_TRANSPORT_LIBNYOCI. See
	  .kiro/specs/coap-transport-cantcoap/ for the full design.

config EDHOC
	bool "EDHOC-to-OSCORE credential bootstrap (lakers)"
	depends on COAP_TRANSPORT
	default n
	help
	  Backs LAKERS_AVAILABLE, enabling oscore_bootstrap::edhoc (see
	  coap-transport-security spec, Requirement 5). Requires a Rust
	  toolchain to build the lakers vcpkg overlay port from source — see
	  vcpkg-overlays/lakers/README.md. vcpkg feature: edhoc. Defaults to
	  n because the Rust toolchain is not assumed to be present; strict
	  mode will fail configure if you select y without it.

config GRPC_TRANSPORT
	bool "gRPC transport (grpc, Protocol Buffers)"
	default y
	help
	  find_package(gRPC CONFIG) and find_package(Protobuf CONFIG).
	  Backs GRPC_FOUND / PROTOBUF_FOUND. vcpkg package: grpc.
	  Generates raft.pb.{h,cc}/raft.grpc.pb.{h,cc} from proto/raft.proto
	  via protoc + grpc_cpp_plugin at build time. Follows the same
	  always-declared-but-gracefully-optional pattern as COAP_TRANSPORT:
	  when gRPC/Protobuf are not found the raft_grpc_transport target is
	  skipped with a warning and the rest of the project configures
	  unaffected, unless KYTHIRA_KCONFIG_STRICT=ON forces a hard failure.
	  See .kiro/specs/grpc-transport/ for the full design.

config ION_SERIALIZER
	bool "Amazon Ion RPC serializer (ion-c)"
	default n
	help
	  find_package(ionc CONFIG). Backs KYTHIRA_ION_SERIALIZER_AVAILABLE.
	  vcpkg feature: ion (vcpkg-overlays/ion-c overlay port; not built by
	  default). Provides ion_rpc_serializer
	  (include/raft/ion_serializer.hpp) as an alternative
	  Types::serializer_type to json_rpc_serializer, using Amazon Ion
	  instead of JSON as the RPC wire format. Follows the same
	  always-declared-but-gracefully-optional pattern as COAP_TRANSPORT and
	  GRPC_TRANSPORT: when ion-c is not found the raft_ion_serializer target
	  is skipped with a warning and the rest of the project configures
	  unaffected, unless KYTHIRA_KCONFIG_STRICT=ON forces a hard failure.
	  Defaults to n because ion-c is an opt-in overlay port not present in a
	  default install. See .kiro/specs/ion-rpc-serializer/ for the full
	  design.

endmenu # Transports

menu "Serialization"

config PROTOBUF_SERIALIZER
	bool "Protocol Buffers rpc_serializer implementation"
	default n
	help
	  find_package(Protobuf CONFIG). Backs Protobuf_FOUND. vcpkg package:
	  protobuf. Generates raft_messages.pb.{h,cc} from
	  proto/raft_messages.proto via protoc at build time. Provides
	  kythira::protobuf_rpc_serializer (include/raft/protobuf_serializer.hpp)
	  as an alternative Types::serializer_type for the existing HTTP/CoAP/TCP
	  transports -- a compact binary wire format with no transport-code
	  change. Independent of GRPC_TRANSPORT (Transports menu): selecting this
	  does not require gRPC, and vice versa -- each declares its own .proto
	  package (kythira.raft.serializer.v1 vs. kythira.raft.v1), so both can be
	  enabled in one build without symbol collision.

endmenu # Serialization

