menu "AWS Integration"

config AWS_SDK
	bool "AWS SDK (EC2/ASG/IAM/S3/STS quorum managers)"
	default y
	help
	  find_package(AWSSDK COMPONENTS core ec2 autoscaling iam s3 sts).
	  Backs KYTHIRA_HAS_AWS_SDK.

config AWS_ACM_PCA
	bool "AWS ACM Private CA provider"
	depends on AWS_SDK
	default y
	help
	  find_package(AWSSDK COMPONENTS acm-pca) — independently found even
	  though it depends on AWS_SDK, because AWSSDKConfig.cmake only
	  defines the acm-pca imported target on a component-scoped call.
	  Backs KYTHIRA_HAS_AWS_ACM_PCA.

config AWS_S3_PERSISTENCE
	bool "AWS S3 object persistence (aws_s3_client)"
	depends on AWS_SDK
	default y
	help
	  Builds aws_s3_client, the S3 member of the key_object_store family
	  that object_store_persistence_engine is generic over, and its unit
	  suite. Selects what is *built*; it gates no find_package of its own
	  and has no KYTHIRA_HAS_* counterpart, because the s3 component it
	  needs is already in the unconditional AWSSDK component list that
	  AWS_SDK's own probe resolves.

	  Depends on AWS_SDK for that reason: unlike the Azure, OCI and Alibaba
	  object clients, this one is written against a vendor SDK rather than
	  against the REST API directly.

endmenu # AWS Integration

menu "GCP Integration"

config GCP_SDK
	bool "GCP Compute SDK (Compute Engine / MIG quorum managers)"
	default y
	help
	  find_package(google_cloud_cpp_compute COMPONENTS compute_instances
	  compute_instance_group_managers compute_zone_operations).
	  Backs KYTHIRA_HAS_GCP_SDK.

config GCP_PRIVATECA
	bool "GCP Certificate Authority Service provider"
	depends on GCP_SDK
	default y
	help
	  find_package(google_cloud_cpp_privateca) — found independently of the
	  compute components, mirroring AWS_ACM_PCA's independence from AWS_SDK,
	  so a build with compute but without privateca (or vice versa) still
	  configures cleanly. Backs KYTHIRA_HAS_GCP_PRIVATECA.

config GCP_STORAGE
	bool "GCP Cloud Storage object client (gcp_gcs_client)"
	default y
	help
	  find_package(google_cloud_cpp_storage) — the object client the
	  cloud-object-persistence engine instantiates over GCS.

	  Deliberately does NOT depend on GCP_SDK, unlike GCP_PRIVATECA above.
	  The storage component shares no code with the Compute API surface, and
	  a node that persists Raft state in GCS has no reason to also carry the
	  Compute quorum managers. Backs KYTHIRA_HAS_GCP_STORAGE.

config GCP_STORAGE_PERSISTENCE
	bool "GCP Cloud Storage object persistence (gcp_gcs_client)"
	depends on GCP_STORAGE
	default y
	help
	  Builds gcp_gcs_client, the GCS member of the key_object_store family,
	  and its unit suite. Selects what is *built*: the find_package it
	  relies on is GCP_STORAGE's, so this symbol invents no KYTHIRA_HAS_*
	  counterpart of its own.

	  Split from GCP_STORAGE rather than folded into it so that the two
	  questions stay separate — "was the storage component found?" and "do
	  we want the GCS persistence backend built?" — matching how
	  ALIBABA_OSS_PERSISTENCE is independent of the Alibaba quorum manager.

endmenu # GCP Integration
menu "Azure Integration"

config AZURE_SDK
	bool "Azure SDK for C++ (VM/VMSS quorum managers)"
	default y
	help
	  find_package(azure-core-cpp CONFIG) + find_package(azure-identity-cpp CONFIG).
	  Backs KYTHIRA_HAS_AZURE_SDK.

config AZURE_KEY_VAULT
	bool "Azure Key Vault Keys (CA provider)"
	depends on AZURE_SDK
	default y
	help
	  find_package(azure-security-keyvault-keys-cpp CONFIG) — independently
	  found even though it depends on AZURE_SDK for credential types.
	  Backs KYTHIRA_HAS_AZURE_KEY_VAULT.

config AZURE_BLOB_PERSISTENCE
	bool "Azure Blob object persistence (azure_blob_client)"
	depends on HTTP_TRANSPORT_TLS && AZURE_SDK
	default y
	help
	  Builds azure_blob_client, the Azure member of the key_object_store
	  family, and its unit suite. Selects what is *built* and gates no
	  find_package of its own, so it has no KYTHIRA_HAS_* counterpart —
	  the same no-SDK-to-find shape OCI_OBJECT_PERSISTENCE and
	  ALIBABA_OSS_PERSISTENCE use.

	  Requires HTTP_TRANSPORT_TLS because the client speaks the Blob REST
	  API over httplib and Azure is https-only, and that symbol is what
	  defines CPPHTTPLIB_OPENSSL_SUPPORT. It also depends on AZURE_SDK,
	  which is NOT a storage SDK dependency — task 0.6's decision to take
	  no azure-storage-blobs-cpp dependency stands. What it needs from
	  azure-identity is the credential chain the bearer token comes from.

endmenu # Azure Integration

menu "OCI Integration"

# Unlike every other cloud menu above, these two gate no find_package call.
# There is no OCI SDK to look for: the providers sign their own requests
# (include/raft/oci_signing.hpp) and send them over httplib, which is exactly
# what keeps this feature out of vcpkg.json. So these symbols select whether
# OCI support is *built*, not whether a dependency was *found* — which is why
# neither has a KYTHIRA_HAS_* counterpart, and why turning one off cannot fail
# a strict-mode configure the way GCP_SDK=y without the SDK does.
#
# Both depend on HTTP_TRANSPORT_TLS, which is not an aesthetic choice: every OCI
# endpoint is https, and CPPHTTPLIB_OPENSSL_SUPPORT — which only that symbol
# defines — is what gives cpp-httplib an https client at all. Without it
# httplib::Client rejects an https origin outright, so OCI support would build
# cleanly and then fail on its first real call. Nothing caught that, because
# every OCI test points endpoint_override at a plain-http local server.
# HTTP_TRANSPORT_TLS in turn depends on HTTP_TRANSPORT and OPENSSL, which is
# also exactly right: the signing is OpenSSL EVP and the transport is httplib.

config OCI_QUORUM_MANAGER
	bool "OCI Instance Pool quorum manager"
	depends on HTTP_TRANSPORT_TLS
	default y
	help
	  Builds oci_instance_pool_quorum_manager and the OCI request-signing
	  and HTTP plumbing it shares with the certificate provider. Needs only
	  OpenSSL, httplib and boost::json, all of which are unconditional
	  dependencies already.

	  Requires HTTP_TRANSPORT_TLS: OCI is https-only, and that symbol is
	  what defines CPPHTTPLIB_OPENSSL_SUPPORT.

config OCI_CERTIFICATES_PROVIDER
	bool "OCI Certificates Management certificate provider"
	depends on HTTP_TRANSPORT_TLS
	default y
	help
	  Builds oci_certificates_provider. Independent of OCI_QUORUM_MANAGER
	  rather than depending on it — the two share the signing/HTTP layer but
	  neither uses the other, mirroring how AWS_ACM_PCA is found separately
	  from AWS_SDK, so a deployment can take certificates without quorum
	  management or the reverse.

	  Requires HTTP_TRANSPORT_TLS, for the same reason OCI_QUORUM_MANAGER
	  does.

config OCI_OBJECT_PERSISTENCE
	bool "OCI Object Storage object persistence (oci_object_storage_client)"
	depends on HTTP_TRANSPORT_TLS
	default y
	help
	  Builds oci_object_storage_client, the OCI member of the
	  key_object_store family, and its unit suite. Like the two OCI symbols
	  above it gates no find_package and has no KYTHIRA_HAS_* counterpart:
	  there is no OCI SDK to look for, and the client reuses oci_signing /
	  oci_http_client, so Instance Principal auth comes along for free.

	  Independent of OCI_QUORUM_MANAGER rather than depending on it — they
	  share the signing layer but neither uses the other, the same sibling
	  relationship ALIBABA_OSS_PERSISTENCE has.

	  Requires HTTP_TRANSPORT_TLS for the reason the two symbols above do.

endmenu # OCI Integration

menu "Alibaba Cloud Integration"

# Same shape as the OCI menu above, and for the same reason: these gate no
# find_package call. There is no Alibaba SDK dependency — the general
# aliyun-openapi-cpp-sdk is not in the vcpkg registry, and pulling in the
# OSS-only one would add a second HTTP stack (libcurl) beside httplib and
# bury the persistence engine's durability-critical retry behavior inside a
# vendor client. So the components sign their own requests
# (include/raft/alibaba_signing.hpp for the ACS3-HMAC-SHA256 control plane,
# include/raft/alibaba_oss_client.hpp for OSS V4) and send them over httplib.
# These symbols therefore select whether Alibaba support is *built*, not
# whether a dependency was *found*, which is why neither has a KYTHIRA_HAS_*
# counterpart.
#
# Both depend on HTTP_TRANSPORT_TLS for the reason the OCI menu documents at
# length: every Alibaba endpoint is https, CPPHTTPLIB_OPENSSL_SUPPORT comes
# only from that symbol, and without it support would build cleanly and fail
# on its first real call — invisible to a test tier that points
# endpoint_override at a plain-http local server.

config ALIBABA_QUORUM_MANAGER
	bool "Alibaba Cloud ESS quorum manager"
	depends on HTTP_TRANSPORT_TLS
	default y
	help
	  Builds alibaba_ess_quorum_manager and the Alibaba request-signing and
	  HTTP plumbing it shares with the OSS persistence engine. Needs only
	  OpenSSL, httplib and boost::json, all unconditional dependencies
	  already.

	  Requires HTTP_TRANSPORT_TLS: Alibaba is https-only, and that symbol is
	  what defines CPPHTTPLIB_OPENSSL_SUPPORT.

config ALIBABA_OSS_PERSISTENCE
	bool "Alibaba Cloud OSS persistence engine"
	depends on HTTP_TRANSPORT_TLS
	default y
	help
	  Builds alibaba_oss_persistence_engine, a kythira::persistence_engine
	  storing term/voted_for/log/snapshot as OSS objects. Independent of
	  ALIBABA_QUORUM_MANAGER rather than depending on it — the two share the
	  signing layer but neither uses the other, mirroring how the OCI
	  quorum manager and certificate provider are siblings.

	  Requires HTTP_TRANSPORT_TLS, for the same reason ALIBABA_QUORUM_MANAGER
	  does.

endmenu # Alibaba Cloud Integration

