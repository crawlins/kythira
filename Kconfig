	default y
	help
	  PkgConfig module libfiu. Backs CHAOS_TESTS_ENABLED and FIU_ENABLE.

endmenu # Test-Only Dependencies

menu "Futures"

config FOLLY
	bool "folly-backed Future/Promise/Executor backend"
	default y
	help
	  The original, default kythira::Future/Promise/Try backend
	  (include/raft/future.hpp). Gates find_package(folly) the same way
	  CONFIG_STDEXEC_BACKEND/CONFIG_BOOST_FUTURE_BACKEND gate their own
	  dependencies -- deselecting it skips probing for Folly entirely.
	  Selected by default because it's the only backend with no
	  additional vcpkg feature/toolchain requirement. Deselecting it is
	  fully supported at the header level as of the folly-decoupling
	  work (July 2026): production code no longer requires Folly
	  transitively through future_default.hpp regardless of which
	  backend is selected, verified by a real, Folly-hidden-from-the-
	  include-path compile of every affected header under both
	  alternate backends. Test files' own folly::init()/folly::Init
	  Boost.Test bootstrap (135 files, not the ~30 originally estimated)
	  is likewise now backend-conditional as of July 2026 -- gated behind
	  the same KYTHIRA_FUTURE_BACKEND_STDEXEC/BOOST checks used elsewhere,
	  not deleted outright, since several of them transitively need
	  Folly's Timekeeper singleton initialized (e.g. error_handler.hpp's
	  retry-backoff delays) whenever future_default<T> resolves to
	  folly::Future<T> under this backend. certificate_authority and
	  tests/ are also now correctly buildable with CONFIG_FOLLY=n and an
	  alternate backend selected (July 2026): the CMakeLists.txt
	  subdirectory-level gates check whether the *selected* backend's
	  dependency is satisfied, not folly_FOUND specifically, and the
	  genuinely Folly-only tests (HTTP/CoAP transport -- those headers
	  still hardcode folly::Future<T>, unlike the Raft core -- Folly
	  concept-wrapper tests, cross-backend benchmarks) are individually
	  skipped rather than blocking the whole subdirectory. Two things
	  remain deliberately out of scope: decoupling HTTP/CoAP transport
	  from Folly at the header level (a separate, much larger feature),
	  and examples/ plus the 5 standalone cmd/* production executables,
	  which stay Folly-only since their own main()s call folly::init()
	  directly by design; see doc/TODO.md's "Known Follow-ups" for
	  details.

config STDEXEC_BACKEND
	bool "stdexec-backed Future/Promise/Executor backend"
	default n
	help
	  Backs the second Future backend from the stdexec-future-backend
	  spec. vcpkg package: stdexec.

config BOOST_FUTURE_BACKEND
	bool "boost::thread-backed Future/Promise/Executor backend"
	default n
	help
	  Backs the third Future backend from the boost-future-backend spec
	  (include/raft/future_boost.hpp). boost::thread/boost::asio are
	  already hard-required dependencies of this project for unrelated
	  reasons; this only controls whether this backend's own targets/
	  headers are built. Backs KYTHIRA_HAS_BOOST_FUTURE.

comment "WARNING: select at least one Future backend above"
	depends on !FOLLY && !STDEXEC_BACKEND && !BOOST_FUTURE_BACKEND

choice
	prompt "Default kythira::Future backend"
	default DEFAULT_FUTURE_BACKEND_FOLLY if FOLLY
	default DEFAULT_FUTURE_BACKEND_STDEXEC if STDEXEC_BACKEND
	default DEFAULT_FUTURE_BACKEND_BOOST if BOOST_FUTURE_BACKEND
	help
	  Selects the KYTHIRA_DEFAULT_FUTURE_BACKEND alias target introduced
	  by the stdexec-future-backend spec (Requirement 11.3). Only affects
	  non-templated call sites using kythira::future_default; templated
	  core code accepts either backend regardless of this choice. Folly
	  is the default whenever it's enabled (the common case); if it's
	  been deselected above, the default falls through to whichever
	  other backend is enabled instead.

config DEFAULT_FUTURE_BACKEND_FOLLY
	bool "folly"
	depends on FOLLY

config DEFAULT_FUTURE_BACKEND_STDEXEC
	bool "stdexec"
	depends on STDEXEC_BACKEND

config DEFAULT_FUTURE_BACKEND_BOOST
	bool "boost"
	depends on BOOST_FUTURE_BACKEND

endchoice

endmenu # Futures

# (mainmenu close is implicit at EOF)
