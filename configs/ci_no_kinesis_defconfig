# ci_no_kinesis_defconfig — ci_full_defconfig with the Kinesis module
# (services/kinesis/, .kiro/specs/kinesis-compatible-streams/) switched off.
# kinesis-module.yml configures core with it to show that with
# CONFIG_KINESIS off nothing under services/kinesis/ is configured: no
# Kinesis target and no kinesis-module test. Written, like
# ci_full_defconfig, against `-DKYTHIRA_KCONFIG_STRICT=ON`; see that file's
# header for the reasoning behind every other line, which must stay verbatim
# from it.
#
#   KINESIS                 — the point of the file.
# CONFIG_KINESIS is not set
CONFIG_EDHOC=y
CONFIG_STDEXEC_BACKEND=y
CONFIG_BOOST_FUTURE_BACKEND=y
CONFIG_BOOST_BEAST_TRANSPORT=y
CONFIG_PROXYGEN_TRANSPORT=y
CONFIG_REDIS_GATEWAY=y
CONFIG_REDIS_GATEWAY_TRANSACTIONS=y
CONFIG_PROTOBUF_SERIALIZER=y
# CONFIG_GCP_SDK is not set
# CONFIG_GCP_PRIVATECA is not set
# CONFIG_GCP_STORAGE is not set
# CONFIG_GCP_STORAGE_PERSISTENCE is not set
# CONFIG_DNS_DISCOVERY is not set
# CONFIG_POCO_DISCOVERY is not set
CONFIG_IAM=y
