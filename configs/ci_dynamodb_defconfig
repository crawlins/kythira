# ci_dynamodb_defconfig — ci_full_defconfig with CONFIG_ENGINE_ROCKSDB on.
# dynamodb-module.yml's build job applies it, with the vcpkg install
# `--x-feature=edhoc --x-feature=rocksdb`, so that its
# dynamodb_gateway_node keeps a cluster node's groups in RocksDB: the chaos
# scenario (services/dynamodb/tools/chaos/, .kiro/specs/
# dynamodb-compatible-api/ task 24) SIGKILLs nodes and starts them again,
# which only a node that keeps its Raft state on disk survives. Written,
# like ci_full_defconfig, against `-DKYTHIRA_KCONFIG_STRICT=ON`; see that
# file's header for the reasoning behind every other line, which must stay
# verbatim from it.
#
#   ENGINE_ROCKSDB          — the RocksDB kv_engine, an opt-in vcpkg feature
#                             (rocksdb) this job installs.
CONFIG_ENGINE_ROCKSDB=y
CONFIG_EDHOC=y
CONFIG_STDEXEC_BACKEND=y
CONFIG_BOOST_FUTURE_BACKEND=y
CONFIG_BOOST_BEAST_TRANSPORT=y
CONFIG_PROXYGEN_TRANSPORT=y
CONFIG_REDIS_GATEWAY=y
# Compile redis_gateway_node with the transaction adapter here, so CI builds
# both daemon variants (the other defconfigs keep the unwrapped one).
CONFIG_REDIS_GATEWAY_TRANSACTIONS=y
# Protobuf is always available — `grpc` is an unconditional vcpkg.json
# dependency and pulls it in — so unlike ion-c this is safe to select. It was
# missing from this list while CONFIG_PROTOBUF_SERIALIZER was inert (the
# feature enabled itself off the gRPC block's Protobuf_FOUND regardless), so
# the omission had no visible effect. Honouring the gate made it load-bearing.
CONFIG_PROTOBUF_SERIALIZER=y
# CONFIG_GCP_SDK is not set
# CONFIG_GCP_PRIVATECA is not set
# CONFIG_GCP_STORAGE is not set
# CONFIG_GCP_STORAGE_PERSISTENCE is not set
# CONFIG_DNS_DISCOVERY is not set
# CONFIG_POCO_DISCOVERY is not set
# The IAM module (services/iam/, .kiro/specs/iam-compatible-auth/). Off by
# default like every new module; on here so the build-and-test legs, coverage
# and clang-tidy cover it. Needs only OpenSSL and Boost, which every leg has.
# configs/ci_no_iam_defconfig is this file without it.
CONFIG_IAM=y
# The Kinesis module (services/kinesis/, .kiro/specs/kinesis-compatible-streams/).
# Off by default like every new module; on here so the build-and-test legs,
# coverage and clang-tidy cover it. Needs only OpenSSL and Boost, which every
# leg has. configs/ci_no_kinesis_defconfig is this file without it.
CONFIG_KINESIS=y
# The DynamoDB module (services/dynamodb/, .kiro/specs/dynamodb-compatible-api/).
# Off by default like every new module; on here so the build-and-test legs,
# coverage and clang-tidy cover it. Needs only OpenSSL and Boost, which every
# leg has. configs/ci_no_dynamodb_defconfig is this file without it.
CONFIG_DYNAMODB=y
