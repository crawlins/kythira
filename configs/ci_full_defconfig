# ci_full_defconfig — every optional dependency that the CI image actually
# installs, selected (y). Every other symbol keeps its Kconfig-declared
# default.
#
# The list below is the complete set of `default n` bool symbols this file
# turns on. Getting that set right matters, because a symbol that defaults n
# and is not listed here is *off* in this configuration — which is the opposite
# of what "full" suggests. Four symbols default n and are deliberately NOT
# listed; each is excluded for its own reason, and none of them is an
# oversight:
#
#   COVERAGE                — forcing it on would require Clang and
#                             CMAKE_BUILD_TYPE=Debug project-wide, breaking the
#                             g++-13 jobs that also apply this defconfig.
#                             Coverage is a separate build variant with its own
#                             CI job and its own -DENABLE_COVERAGE=ON.
#   ION_SERIALIZER          — ion-c comes from the opt-in `ion` vcpkg feature,
#                             and no CI job installs it (the main legs use
#                             --x-feature=edhoc only). Selecting it here would
#                             make a strict configure fail on an image that
#                             cannot satisfy it. Enable the vcpkg feature in
#                             ci.yml *first* if this is ever wanted.
#   COAP_TRANSPORT_LIBNYOCI — same shape: opt-in `coap-libnyoci` vcpkg feature,
#   COAP_TRANSPORT_CANTCOAP   and opt-in `coap-cantcoap`; neither is installed
#                             by any CI job.
#
# GCP_SDK is a related trap in the other direction: it defaults **y**, but
# google-cloud-cpp is installed only by the dedicated GCP job
# (--x-feature=gcp), so this defconfig under strict mode cannot pass on the
# main legs as things stand.
#
# Every CMake-configuring job in ci.yml passes -DKYTHIRA_KCONFIG= this file
# (and installs kconfiglib so the flag takes effect — cmake/Kconfig.cmake
# FATAL_ERRORs on an explicit flag it cannot apply), so CI and a
# kconfiglib-equipped local machine resolve the same feature set from the
# same command. -DKYTHIRA_KCONFIG_STRICT=ON is still not passed anywhere:
# the GCP_SDK default-y trap above means strict mode cannot pass on the
# main legs as things stand, per Requirement 5.1 — see doc/TODO.md.
CONFIG_EDHOC=y
CONFIG_STDEXEC_BACKEND=y
CONFIG_BOOST_FUTURE_BACKEND=y
CONFIG_BOOST_BEAST_TRANSPORT=y
CONFIG_PROXYGEN_TRANSPORT=y
# Protobuf is always available — `grpc` is an unconditional vcpkg.json
# dependency and pulls it in — so unlike ion-c this is safe to select. It was
# missing from this list while CONFIG_PROTOBUF_SERIALIZER was inert (the
# feature enabled itself off the gRPC block's Protobuf_FOUND regardless), so
# the omission had no visible effect. Honouring the gate made it load-bearing.
CONFIG_PROTOBUF_SERIALIZER=y
