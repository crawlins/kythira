# ci_text_node_id_defconfig — ci_full_defconfig plus
# CONFIG_KYTHIRA_NODE_ID_TEXT=y: the host binaries in cmd/ built with
# textual (canonical composite) node ids instead of the numeric default
# (.kiro/specs/cloud-composite-node-ids/ Requirement 10, task 8.4).
#
# Applied by ci.yml's config-variants job, which builds only the
# host_binaries target from it: the library and the test suite take NodeId
# as a template parameter and are already compiled over textual ids by the
# full build, so what this configuration adds is the binaries' own
# std::string instantiations. Running them is left to the numeric legs.
#
# Written against -DKYTHIRA_KCONFIG_STRICT=ON, on the same edhoc-feature
# image as ci_full_defconfig, so every other line below must match that
# file — see its header for why each symbol is on or off. Keep the two in
# sync.
CONFIG_EDHOC=y
CONFIG_STDEXEC_BACKEND=y
CONFIG_BOOST_FUTURE_BACKEND=y
CONFIG_BOOST_BEAST_TRANSPORT=y
CONFIG_PROXYGEN_TRANSPORT=y
CONFIG_REDIS_GATEWAY=y
CONFIG_PROTOBUF_SERIALIZER=y
CONFIG_KYTHIRA_NODE_ID_TEXT=y
# CONFIG_GCP_SDK is not set
# CONFIG_GCP_PRIVATECA is not set
# CONFIG_GCP_STORAGE is not set
# CONFIG_GCP_STORAGE_PERSISTENCE is not set
# CONFIG_DNS_DISCOVERY is not set
# CONFIG_POCO_DISCOVERY is not set
