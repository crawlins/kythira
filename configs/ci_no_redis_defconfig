# ci_no_redis_defconfig — ci_full_defconfig with the Redis gateway module
# (services/redis/, .kiro/specs/redis-gateway-module/) switched off. The
# module's own workflow (.github/workflows/redis-module.yml) builds and tests
# core with it, to show core needs nothing from the module: with CONFIG_REDIS_GATEWAY off nothing under
# services/redis/ is configured, and the core's targets and tests are a
# module-on build's minus the module's. Written, like ci_full_defconfig,
# against `-DKYTHIRA_KCONFIG_STRICT=ON`; see that file's header for the
# reasoning behind every other line, which must stay verbatim from it.
#
#   REDIS_GATEWAY           — the point of the file. REDIS_GATEWAY_TRANSACTIONS
#                             depends on it and goes with it.
CONFIG_EDHOC=y
CONFIG_STDEXEC_BACKEND=y
CONFIG_BOOST_FUTURE_BACKEND=y
CONFIG_BOOST_BEAST_TRANSPORT=y
CONFIG_PROXYGEN_TRANSPORT=y
# CONFIG_REDIS_GATEWAY is not set
CONFIG_PROTOBUF_SERIALIZER=y
# CONFIG_GCP_SDK is not set
# CONFIG_GCP_PRIVATECA is not set
# CONFIG_GCP_STORAGE is not set
# CONFIG_GCP_STORAGE_PERSISTENCE is not set
# CONFIG_DNS_DISCOVERY is not set
# CONFIG_POCO_DISCOVERY is not set
CONFIG_IAM=y
# The Kinesis module (services/kinesis/, .kiro/specs/kinesis-compatible-streams/).
# Off by default like every new module; on here so the build-and-test legs,
# coverage and clang-tidy cover it. Needs only OpenSSL and Boost, which every
# leg has. configs/ci_no_kinesis_defconfig is this file without it.
CONFIG_KINESIS=y
CONFIG_DYNAMODB=y
