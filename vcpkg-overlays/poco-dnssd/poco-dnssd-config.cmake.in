@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Poco COMPONENTS Foundation Net)
find_dependency(PkgConfig)
# Recreates the PkgConfig::AVAHI target the exported PocoDNSSDAvahi links
# against. Without the host's libavahi-client-dev this fails, and the package
# is reported not found rather than failing at link time.
pkg_check_modules(AVAHI QUIET IMPORTED_TARGET avahi-client)
if(NOT TARGET PkgConfig::AVAHI)
    set(poco-dnssd_FOUND FALSE)
    set(poco-dnssd_NOT_FOUND_MESSAGE "avahi-client not found by pkg-config")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/poco-dnssd-targets.cmake")
check_required_components(poco-dnssd)
