{
  "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic_policy-eval-denyallow.html",
  "description": "Resource-based policies within one account: whom a grant names decides whether the boundary and session policy limit it; trust and key policies must allow themselves (INV-EVAL-4, -5, -6, -7, -12).",
  "cases": [
    {
      "name": "resource policy naming the user grants without an identity allow (INV-EVAL-4)",
      "kind": "evaluate",
      "principal": "user/alice",
      "action": "s3:GetObject",
      "resource": "arn:aws:s3:::bucket/key",
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "R",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:user/alice"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::bucket/*"
          }
        ]
      },
      "decided_by": "resource#R",
      "expect": "allow"
    },
    {
      "name": "resource policy naming another user does not grant",
      "kind": "evaluate",
      "principal": "user/alice",
      "action": "s3:GetObject",
      "resource": "arn:aws:s3:::bucket/key",
      "resource_policy": {
        "Version": "2012-10-17",
