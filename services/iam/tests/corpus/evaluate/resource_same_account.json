            "Sid": "R",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:user/bob"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::bucket/*"
          }
        ]
      },
      "expect": "implicit_deny"
    },
