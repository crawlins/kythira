    {
      "name": "deny outside requested regions: allowed region",
      "kind": "evaluate",
      "principal": "user/alice",
      "action": "s3:GetObject",
      "resource": "arn:aws:s3:::bucket/key",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_examples_aws_deny-requested-region.html",
      "context": {
        "aws:RequestedRegion": "eu-west-1"
      },
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "*",
              "Resource": "*"
            },
            {
              "Sid": "DenyAllOutsideRequestedRegions",
              "Effect": "Deny",
              "NotAction": [
                "iam:*",
                "sts:*"
              ],
              "Resource": "*",
              "Condition": {
                "StringNotEquals": {
                  "aws:RequestedRegion": [
                    "eu-central-1",
                    "eu-west-1"
                  ]
                }
              }
            }
          ]
        }
      ],
      "expect": "allow"
    },
    {
      "name": "deny outside requested regions: other region",
      "kind": "evaluate",
      "principal": "user/alice",
      "action": "s3:GetObject",
      "resource": "arn:aws:s3:::bucket/key",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_examples_aws_deny-requested-region.html",
      "context": {
        "aws:RequestedRegion": "us-east-1"
      },
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "*",
              "Resource": "*"
            },
            {
              "Sid": "DenyAllOutsideRequestedRegions",
              "Effect": "Deny",
              "NotAction": [
                "iam:*",
                "sts:*"
              ],
              "Resource": "*",
              "Condition": {
                "StringNotEquals": {
                  "aws:RequestedRegion": [
                    "eu-central-1",
                    "eu-west-1"
                  ]
                }
              }
            }
          ]
        }
      ],
      "decided_by": "identity[0]#DenyAllOutsideRequestedRegions",
      "expect": "explicit_deny"
    },
