      "kind": "evaluate",
      "principal": "user/alice",
      "action": "ec2:CreateTags",
      "resource": "*",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/access_tags.html",
      "context": {
        "aws:TagKeys": [
          "Project"
        ],
        "aws:RequestTag/Project": "other"
      },
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "ec2:CreateTags",
              "Resource": "*",
              "Condition": {
                "ForAllValues:StringEquals": {
                  "aws:TagKeys": [
                    "Project",
                    "Owner"
                  ]
                },
                "StringEqualsIfExists": {
                  "aws:RequestTag/Project": [
                    "pegasus",
                    "unicorn"
                  ]
                }
              }
            }
          ]
        }
      ],
      "expect": "implicit_deny"
