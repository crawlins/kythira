    {
      "name": "date range: inside",
      "kind": "evaluate",
      "principal": "user/alice",
      "action": "ec2:RunInstances",
      "resource": "*",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_examples_aws-dates.html",
      "context": {
        "aws:CurrentTime": "2026-05-15T12:00:00Z"
      },
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "ec2:*",
              "Resource": "*",
              "Condition": {
                "DateGreaterThan": {
                  "aws:CurrentTime": "2026-04-01T00:00:00Z"
                },
                "DateLessThan": {
                  "aws:CurrentTime": "2026-06-30T23:59:59Z"
