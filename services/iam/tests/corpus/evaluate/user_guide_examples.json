    {
      "name": "MFA example: Kythira reports no MFA, so the deny applies",
      "kind": "evaluate",
      "principal": "user/alice",
      "action": "s3:GetObject",
      "resource": "arn:aws:s3:::bucket/key",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_examples_aws_my-sec-creds-self-manage.html",
      "context": {
        "aws:MultiFactorAuthPresent": "false"
      },
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "*",
              "Resource": "*"
            },
            {
              "Sid": "DenyAllExceptListedIfNoMFA",
              "Effect": "Deny",
              "NotAction": [
                "iam:ChangePassword",
                "iam:GetUser",
                "sts:GetSessionToken"
              ],
              "Resource": "*",
              "Condition": {
                "BoolIfExists": {
                  "aws:MultiFactorAuthPresent": "false"
                }
              }
            }
          ]
        }
      ],
      "expect": "explicit_deny"
    },
