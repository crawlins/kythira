{
  "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_examples.html",
  "description": "Example policies from the IAM User Guide, evaluated end to end.",
  "cases": [
    {
      "name": "manage own access keys: own user",
      "kind": "evaluate",
      "principal": "user/alice",
      "action": "iam:CreateAccessKey",
      "resource": "arn:aws:iam::111122223333:user/alice",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_examples_iam_credentials_console.html",
      "context": {
        "aws:username": "alice"
      },
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ManageOwnAccessKeys",
              "Effect": "Allow",
              "Action": [
                "iam:CreateAccessKey",
                "iam:DeleteAccessKey",
                "iam:ListAccessKeys",
                "iam:UpdateAccessKey"
              ],
              "Resource": "arn:aws:iam::*:user/${aws:username}"
            }
          ]
        }
      ],
      "expect": "allow"
    },
    {
      "name": "manage own access keys: another user",
      "kind": "evaluate",
      "principal": "user/alice",
      "action": "iam:CreateAccessKey",
      "resource": "arn:aws:iam::111122223333:user/bob",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_examples_iam_credentials_console.html",
      "context": {
        "aws:username": "alice"
      },
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ManageOwnAccessKeys",
              "Effect": "Allow",
              "Action": [
                "iam:CreateAccessKey",
                "iam:DeleteAccessKey",
                "iam:ListAccessKeys",
                "iam:UpdateAccessKey"
              ],
              "Resource": "arn:aws:iam::*:user/${aws:username}"
            }
          ]
        }
      ],
      "expect": "implicit_deny"
    },
    {
