{
  "description": "JSON syntax, duplicate keys (which AWS refuses and a plain JSON parser silently collapses), and the per-document size quotas of Requirement 4.4.",
  "cases": [
    {
      "name": "not JSON",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_grammar.html",
      "policy_text": "{\"Version\": \"2012-10-17\",",
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "Syntax errors in policy."
      }
    },
    {
      "name": "top level is an array",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_grammar.html",
      "policy_text": "[]",
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "the document must be a JSON object"
      }
    },
    {
      "name": "trailing comma",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_grammar.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"*\",}}",
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "Syntax errors in policy."
      }
    },
    {
      "name": "comments are not JSON",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_grammar.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"*\"}} // c",
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "Syntax errors in policy."
      }
    },
    {
      "name": "duplicate top-level key",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_grammar.html",
      "policy_text": "{\"Version\":\"2012-10-17\",\"Version\":\"2008-10-17\",\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"*\"}}",
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "duplicate key \"Version\""
      }
    },
    {
      "name": "duplicate statement key",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_grammar.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:GetObject\",\"Action\":\"s3:PutObject\",\"Resource\":\"*\"}}",
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "duplicate key \"Action\""
      }
    },
    {
      "name": "duplicate principal type",
      "kind": "parse",
      "policy_type": "trust",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_grammar.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"111122223333\",\"AWS\":\"444455556666\"},\"Action\":\"sts:AssumeRole\"}}",
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "duplicate key \"AWS\""
      }
    },
    {
      "name": "same key in sibling statements",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_grammar.html",
      "policy_text": "{\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"*\"},{\"Effect\":\"Deny\",\"Action\":\"*\",\"Resource\":\"*\"}]}",
      "expect": "valid",
      "statements": 2
    },
    {
      "name": "unicode in a resource",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_grammar.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":\"arn:aws:s3:::b/caf\\u00e9\"}}",
      "expect": "valid"
    },
    {
      "name": "managed policy at exactly 6144 characters",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_iam-quotas.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"arn:aws:s3:::\"}}",
      "expect": "valid"
    },
    {
      "name": "managed policy at 6145 characters",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_iam-quotas.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"arn:aws:s3:::\"}}",
      "expect": {
        "code": "LimitExceeded",
        "message": "Cannot exceed quota for PolicySize: 6144"
      }
    },
    {
      "name": "whitespace does not count toward the quota",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_iam-quotas.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",          \n\"Action\":\"*\",          \n\"Resource\":\"arn:aws:s3:::\"}}",
      "expect": "valid"
    },
    {
      "name": "trust policy over 2048 characters",
      "kind": "parse",
      "policy_type": "trust",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_iam-quotas.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"arn:aws:iam::123456789012:\"},\"Action\":\"sts:AssumeRole\"}}",
      "expect": {
        "code": "LimitExceeded",
        "message": "Cannot exceed quota for PolicySize: 2048"
      }
    },
    {
      "name": "session policy over 2048 characters",
      "kind": "parse",
      "policy_type": "session",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_temp_control-access_assumerole.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"arn:aws:s3:::\"}}",
      "expect": {
        "code": "LimitExceeded",
        "message": "Cannot exceed quota for PolicySize: 2048"
      }
    },
    {
      "name": "raised quota admits a larger policy",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_iam-quotas.html",
      "policy_text": "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"arn:aws:s3:::\"}}",
      "expect": "valid",
      "max_size": 10240
    }
  ]
}
