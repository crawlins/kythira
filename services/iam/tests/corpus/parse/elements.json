            "Resource": "arn:aws:s3:::bucket/*"
          }
        ]
      },
      "expect": "valid"
    },
    {
      "name": "sid with a space in an identity policy",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_sid.html",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Sid": "Read Only",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::bucket/*"
          }
        ]
      },
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "Statement IDs (SID) must be alpha-numeric"
      }
    },
    {
      "name": "sid with a hyphen in an identity policy",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_sid.html",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Sid": "read-only",
