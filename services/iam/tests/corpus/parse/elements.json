{
  "description": "Each policy element's accepted and refused forms (Requirement 5.1, 5.2).",
  "cases": [
    {
      "name": "version 2012-10-17",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_version.html",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::bucket/*"
          }
        ]
      },
      "expect": "valid"
    },
    {
      "name": "version 2008-10-17",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_version.html",
      "policy": {
        "Version": "2008-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::bucket/*"
          }
        ]
      },
      "expect": "valid"
    },
    {
      "name": "version omitted defaults to 2008-10-17",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_version.html",
      "policy": {
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::bucket/*"
          }
        ]
      },
      "expect": "valid"
    },
    {
      "name": "version is a date AWS never published",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_version.html",
      "policy": {
        "Version": "2020-01-01",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::bucket/*"
          }
        ]
      },
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "The policy failed legacy parsing"
      }
    },
    {
      "name": "version as a number",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_version.html",
      "policy": {
        "Version": 2012,
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::bucket/*"
          }
        ]
      },
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "The policy failed legacy parsing"
      }
    },
    {
      "name": "statement as a single object",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_statement.html",
      "policy": {
        "Version": "2012-10-17",
        "Statement": {
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "arn:aws:s3:::bucket/*"
        }
      },
      "expect": "valid",
      "statements": 1
    },
    {
      "name": "statement as an array of two",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_statement.html",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::bucket/*"
          },
          {
            "Effect": "Deny",
            "Action": "s3:DeleteObject",
            "Resource": "*"
          }
        ]
      },
      "expect": "valid",
      "statements": 2
    },
    {
      "name": "statement missing",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_statement.html",
      "policy": {
        "Version": "2012-10-17"
      },
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "missing required field Statement"
      }
    },
    {
      "name": "statement empty array",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_statement.html",
      "policy": {
        "Version": "2012-10-17",
        "Statement": []
      },
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "Statement must not be empty"
      }
    },
    {
      "name": "statement as a string",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_statement.html",
      "policy": {
        "Version": "2012-10-17",
        "Statement": "Allow"
      },
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "Statement must be an object or an array"
      }
    },
    {
      "name": "statement array holds a string",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_statement.html",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          "x"
        ]
      },
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "each Statement must be an object"
      }
    },
    {
      "name": "Id is accepted",
      "kind": "parse",
      "policy_type": "resource",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_id.html",
      "policy": {
        "Version": "2012-10-17",
        "Id": "S3-Account-Permissions",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:root"
            },
            "Action": "s3:*",
            "Resource": "arn:aws:s3:::amzn-s3-demo-bucket/*"
          }
        ]
      },
      "expect": "valid"
    },
    {
      "name": "Id must be a string",
      "kind": "parse",
      "policy_type": "identity",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_id.html",
      "policy": {
        "Version": "2012-10-17",
        "Id": 7,
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::bucket/*"
          }
        ]
      },
      "expect": {
        "code": "MalformedPolicyDocument",
        "message": "Id must be a string"
      }
    },
    {
      "name": "sid alphanumeric",
      "kind": "parse",
      "policy_type": "identity",
