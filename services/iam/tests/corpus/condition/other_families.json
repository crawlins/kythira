        "aws:SourceArn": "arn:aws:sns:us-east-1:111122223333:topic"
      },
      "match": true
    },
    {
      "name": "ArnLike arn:aws:sns:*:111122223333:* vs arn:aws:sns:us-east-1:111122223333:topic",
      "kind": "condition",
      "condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:sns:*:111122223333:*"
        }
      },
      "context": {
        "aws:SourceArn": "arn:aws:sns:us-east-1:111122223333:topic"
      },
      "match": true
