    {
      "name": "Null true holds when the key is absent",
      "kind": "condition",
      "condition": {
        "Null": {
          "aws:TokenIssueTime": "true"
        }
      },
      "context": {},
      "match": true
    },
    {
      "name": "Null true fails when the key is present",
      "kind": "condition",
      "condition": {
        "Null": {
          "aws:TokenIssueTime": "true"
        }
      },
      "context": {
        "aws:TokenIssueTime": "2020-01-01T00:00:00Z"
      },
      "match": false
    },
    {
      "name": "Null false holds when the key is present",
      "kind": "condition",
      "condition": {
        "Null": {
          "aws:TokenIssueTime": "false"
        }
      },
      "context": {
        "aws:TokenIssueTime": "2020-01-01T00:00:00Z"
      },
      "match": true
    },
    {
      "name": "Null false fails when the key is absent",
      "kind": "condition",
      "condition": {
