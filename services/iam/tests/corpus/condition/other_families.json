{
  "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html",
  "description": "Bool, BinaryEquals, IpAddress/NotIpAddress (IPv4 and IPv6 CIDR), the Arn family (segment by segment, case-sensitive) and Null.",
  "cases": [
    {
      "name": "Bool true vs true",
      "kind": "condition",
      "condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      },
      "context": {
        "aws:SecureTransport": "true"
      },
      "match": true
    },
    {
      "name": "Bool false vs true",
      "kind": "condition",
      "condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      },
      "context": {
        "aws:SecureTransport": "true"
      },
      "match": false
    },
    {
      "name": "Bool is case-insensitive",
      "kind": "condition",
      "condition": {
        "Bool": {
          "aws:SecureTransport": "TRUE"
        }
      },
      "context": {
        "aws:SecureTransport": "true"
      },
      "match": true
    },
    {
      "name": "Bool takes a JSON boolean",
      "kind": "condition",
      "condition": {
        "Bool": {
          "aws:SecureTransport": false
        }
      },
      "context": {
        "aws:SecureTransport": "false"
      },
      "match": true
    },
    {
      "name": "Bool missing key is false",
      "kind": "condition",
      "condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      },
      "context": {},
      "match": false
    },
    {
      "name": "BinaryEquals compares decoded base64 bytes",
      "kind": "condition",
      "condition": {
        "BinaryEquals": {
          "ex:blob": "QmluYXJ5VmFsdWVJbkJhc2U2NA=="
        }
      },
      "context": {
        "ex:blob": "BinaryValueInBase64"
      },
      "match": true
    },
    {
      "name": "BinaryEquals different bytes",
      "kind": "condition",
      "condition": {
        "BinaryEquals": {
          "ex:blob": "QmluYXJ5VmFsdWVJbkJhc2U2NA=="
        }
      },
      "context": {
        "ex:blob": "Other"
      },
      "match": false
    },
    {
      "name": "BinaryEquals with invalid base64 matches nothing",
      "kind": "condition",
      "condition": {
        "BinaryEquals": {
          "ex:blob": "not base64"
        }
      },
      "context": {
        "ex:blob": "x"
      },
      "match": false
    },
