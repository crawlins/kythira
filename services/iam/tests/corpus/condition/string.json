    {
      "name": "StringEquals ORs its values",
      "kind": "condition",
      "condition": {
        "StringEquals": {
          "aws:username": [
            "alice",
            "bob"
          ]
        }
      },
      "context": {
        "aws:username": "bob"
      },
      "match": true
    },
    {
      "name": "StringNotEquals with several values is NOR: matching one fails",
      "kind": "condition",
      "condition": {
        "StringNotEquals": {
          "aws:username": [
            "alice",
            "bob"
          ]
        }
      },
      "context": {
        "aws:username": "bob"
      },
      "match": false,
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-logic-multiple-context-keys-or-values.html"
    },
    {
      "name": "StringNotEquals with several values is NOR: matching none holds",
      "kind": "condition",
      "condition": {
        "StringNotEquals": {
          "aws:username": [
            "alice",
            "bob"
          ]
        }
      },
      "context": {
        "aws:username": "carol"
      },
      "match": true,
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-logic-multiple-context-keys-or-values.html"
    },
    {
      "name": "StringNotLike with several values is NOR",
      "kind": "condition",
      "condition": {
        "StringNotLike": {
          "aws:username": [
            "a*",
            "b*"
          ]
        }
      },
      "context": {
        "aws:username": "bob"
      },
      "match": false,
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-logic-multiple-context-keys-or-values.html"
    },
    {
      "name": "StringEquals compares a number value as its text",
      "kind": "condition",
      "condition": {
        "StringEquals": {
          "s3:max-keys": 10
        }
      },
      "context": {
        "s3:max-keys": "10"
      },
      "match": true
    }
