          "aws:username": "alice"
        }
      },
      "context": {
        "aws:username": "bob"
      },
      "match": true
    },
    {
      "name": "StringNotEquals alice vs alice",
      "kind": "condition",
      "condition": {
        "StringNotEquals": {
          "aws:username": "alice"
        }
      },
      "context": {
        "aws:username": "alice"
      },
      "match": false
    },
    {
