      "context": {
        "aws:username": "ALICE"
      },
      "match": true
    },
    {
      "name": "StringEqualsIgnoreCase alice vs bob",
      "kind": "condition",
      "condition": {
        "StringEqualsIgnoreCase": {
          "aws:username": "alice"
        }
      },
      "context": {
        "aws:username": "bob"
      },
      "match": false
    },
    {
      "name": "StringNotEqualsIgnoreCase alice vs ALICE",
      "kind": "condition",
      "condition": {
        "StringNotEqualsIgnoreCase": {
          "aws:username": "alice"
        }
      },
      "context": {
        "aws:username": "ALICE"
      },
      "match": false
