  "cases": [
    {
      "name": "StringEquals alice vs alice",
      "kind": "condition",
      "condition": {
        "StringEquals": {
          "aws:username": "alice"
        }
      },
      "context": {
        "aws:username": "alice"
      },
      "match": true
    },
    {
      "name": "StringEquals alice vs Alice",
      "kind": "condition",
      "condition": {
        "StringEquals": {
          "aws:username": "alice"
        }
      },
      "context": {
        "aws:username": "Alice"
      },
      "match": false
    },
    {
      "name": "StringEquals alice vs bob",
      "kind": "condition",
      "condition": {
