          "aws:username": "alice-*"
        }
      },
      "context": {
        "aws:username": "alice-dev"
      },
      "match": true
    },
    {
      "name": "StringLike alice-* vs bob-dev",
      "kind": "condition",
      "condition": {
        "StringLike": {
          "aws:username": "alice-*"
        }
      },
      "context": {
        "aws:username": "bob-dev"
      },
      "match": false
    },
    {
